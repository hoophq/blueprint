    if (!t || decCmp(decAdd(a, u), t) !== 0) return line + "  ⚠ does not reconcile: reported " + c.total;
    return line + "  ✓";
  }

  // probeLine mirrors render.probeLine so the HTML report and the terminal say
  // the same thing about the same probe.
  function probeLine(p) {
    var line;
    switch (p.outcome) {
      case "rows":
        line = p.outcome + " — " + p.rows + " row(s), " + p.matched + " matched to census resources";
        if (p.truncated) {
          line += "; ⚠ AWS caps this query at " + p.rows + " groups and returned exactly that, " +
            "so spend for this service is under-counted by an unknown amount";
        }
        break;
      case "empty":
        line = p.outcome + " — accepted the query and returned no rows, which is not the same as " +
          "reporting no resource-level cost";
        break;
      case "unsupported":
        line = p.outcome + " — AWS rejected the query for this service";
        break;
      case "denied":
        line = p.outcome + " — permission or account opt-in missing";
        break;
      case "skipped":
        line = p.outcome + " — never asked, request budget exhausted";
        break;
      case "uncensused":
        line = p.outcome + " — never asked, no scanner in this run covers it";
        break;
      default:
        line = p.outcome;
    }
    if (p.detail) line += ": " + p.detail;
    return line;
  }

