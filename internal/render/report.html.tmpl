  // window go in the sub-line and the tooltip; the head itself carries the one
  // word that stops the two columns being read as the same measurement twice.
  var METHOD_COLUMNS = { ce: "Billed", coh: "Modelled" };

  function methodLabel(m) {
    return METHOD_LABELS[m] || m || "unnamed source";
