        "figure here is what a resource was charged, not what removing it frees.";
    }
    return "Figures use the " + m + " metric. Commitments and prepaid capacity are billed whether or not the " +
      "resource they cover still exists, so a figure here is what a resource was charged, not what removing it frees.";
  }

  var NO_ESTIMATE_NOTE = "This report therefore does not estimate what deleting a resource returns: that depends on " +
    "commitment coverage, rate plans, and what else moves onto the same commitment — none of which a read-only " +
    "census can see.";

  // ---- Cost aggregates ------------------------------------------------------

  // groupReasons splits the rows carrying no usable figure into the kinds of
  // reason there are for that, ordered the way the terminal renderer orders
  // them: commonest first, then alphabetically.
  //
  // It accounts for every row it is handed, and that is the whole point of it.
  // Dropping a kind leaves the groups totalling less than the gap the caller
  // just stated, with the remainder unexplained — in the demo estate the tile
  // said 70 and the panel titled "Why a figure is missing" listed 66.
  //
  // Four kinds, because they are four different claims and only one of them is
  // a thing AWS said:
  //
  //   recorded    a cost pass wrote a reason, carried in reason
  //   offCurrency AWS priced it, in a currency this page is not totalling
  //   unparsed    AWS priced it, in something that is not a decimal number
  //   silent      no pass said anything, and reason is empty because there is
  //               none to carry
  //
  // The two exclusions are not absences and may not be worded as any: the row
  // has an amount, printed in the table, with costText explaining the exclusion
  // in its tooltip. Reporting those under "no cause recorded" contradicts the
  // page's own row. And silence is not a reason either — only Cost Optimization
  // Hub writes one, the resource-level Cost Explorer pass deliberately writes
  // nothing rather than guess at a cause — so each caller words that group
  // itself rather than printing a reason string that was never recorded.
  //
  // A row can qualify for two of these at once: Cost Optimization Hub recording
  // that it has no recommendation says nothing about why the active Cost
  // Explorer figure is in euros. The kind stamped by stampCosts wins, because
  // it is about the figure the reader is looking at.
  var REASON_KINDS = ["recorded", "offCurrency", "unparsed", "silent"];

  function groupReasons(rows) {
    var byReason = {};
    var excluded = { offCurrency: 0, unparsed: 0, silent: 0 };
    rows.forEach(function (r) {
      if (r._costGap === "offCurrency" || r._costGap === "unparsed") excluded[r._costGap]++;
      else if (r.cost_unavailable) byReason[r.cost_unavailable] = (byReason[r.cost_unavailable] || 0) + 1;
      else excluded.silent++;
    });
    var out = Object.keys(byReason).map(function (why) {
      return { reason: why, count: byReason[why], kind: "recorded" };
    });
    REASON_KINDS.forEach(function (kind) {
      if (kind !== "recorded" && excluded[kind]) out.push({ reason: "", count: excluded[kind], kind: kind });
    });
    out.sort(function (a, b) {
      if (a.count !== b.count) return b.count - a.count;
      var ra = REASON_KINDS.indexOf(a.kind), rb = REASON_KINDS.indexOf(b.kind);
      if (ra !== rb) return ra - rb;
      return a.reason < b.reason ? -1 : (a.reason > b.reason ? 1 : 0);
    });
    return out;
  }

  // tierSpend totals the active method's figures per attribution tier. Only
  // figures in the active currency are added; a lone EUR row keeps its amount on
  // its own row and stays out of every total.
  function tierSpend(rows) {
    var byTier = {};
    TIERS.forEach(function (t) { byTier[t.key] = { amounts: [], priced: 0, count: 0 }; });
    var all = [];
    rows.forEach(function (r) {
      var b = byTier[r._tier];
      if (!b) return;
      b.count++;
      if (r._costDec) {
        b.amounts.push(r._costDec);
        b.priced++;
        all.push(r._costDec);
      }
    });
    return {
      total: decSum(all),
      priced: all.length,
      tiers: TIERS.map(function (t) {
        var b = byTier[t.key];
        return { key: t.key, label: t.label, color: t.color, sum: decSum(b.amounts), priced: b.priced, count: b.count };
      })
    };
  }

  // serviceSpend ranks services by what their priced resources cost. Services
  // with nothing priced keep a row and no bar: a service AWS reported no spend
  // for is a different statement from a service that costs nothing, and hiding
  // it would make the page look complete when it is not.
  function serviceSpend(rows) {
    var by = {};
    var order = [];
    rows.forEach(function (r) {
      var name = r.service || "";
      var s = by[name];
      if (!s) {
        s = by[name] = { service: name, amounts: [], count: 0, priced: 0, engines: {} };
        order.push(s);
      }
      s.count++;
      if (r._costDec) { s.amounts.push(r._costDec); s.priced++; }
      if (r._engine) s.engines[r._engine] = (s.engines[r._engine] || 0) + 1;
    });
    order.forEach(function (s) { s.sum = decSum(s.amounts); });
    order.sort(function (a, b) {
      if (!a.sum !== !b.sum) return a.sum ? -1 : 1;
      if (a.sum && b.sum) {
        var c = decCmp(b.sum, a.sum);
        if (c !== 0) return c;
      }
      if (a.count !== b.count) return b.count - a.count;
      return a.service < b.service ? -1 : (a.service > b.service ? 1 : 0);
    });
    return order;
  }

  // engineBreakdown is the platform detail the Platforms section used to carry,
  // surviving as a sub-label on the service that owns it.
  function engineBreakdown(s) {
    return Object.keys(s.engines).sort(function (a, b) {
      if (s.engines[a] !== s.engines[b]) return s.engines[b] - s.engines[a];
      return a < b ? -1 : (a > b ? 1 : 0);
    }).map(function (name) {
      return name + " " + s.engines[name];
    }).join(" · ");
  }

  // costText decides what a cost cell says, separately from building it, so the
  // three states a reader has to be able to tell apart stay testable: a reported
  // figure (a reported "0.00" included), an absence AWS explained, and an
  // absence it did not. None of them renders as zero.
  // The method is a parameter because the table now gives each source its own
  // column, so the same row is asked this question once per source. The
  // currency it is judged against is that source's own dominant currency, not
  // the selected basis: a column headed "Cost Optimization Hub" that dimmed
  // every figure for being in the wrong currency, because the *other* source
  // mostly reported a different one, would be marking the column's own subject
  // as foreign to itself.
  function costText(r, m) {
    var method = m === undefined ? COST.method : m;
    var cell = (r._costBy || {})[method];
    var c = cell ? cell.rec : null;
    var currency = COST.currencyBy[method] || "";
    if (!c) {
      // The reason is quoted, not offered as the explanation for this absence.
      // cost_unavailable is written by whichever pass had something to say, and
      // only Cost Optimization Hub writes one at all — the resource-level Cost
      // Explorer pass deliberately records none, because naming a cause for a
      // row Cost Explorer simply did not return would be a guess. Splicing the
      // two with an em dash made a Hub sentence answer for Cost Explorer: "No
      // Cost Explorer figure — no Cost Optimization Hub recommendation for this
      // resource", which reads as one source explaining the other's silence.
      return {
        text: "",
        dim: true,
        flag: "",
        title: "No " + methodLabel(method) + " figure for this resource." +
          (r.cost_unavailable ? " The cost pass recorded: " + r.cost_unavailable : "")
      };
    }
    var parts = [c.estimated
      ? "Modelled monthly rate from " + methodLabel(c.method) + " rather than a billed amount."
      : "Billed figure from " + methodLabel(c.method) + "."];
    var win = costWindowSentence(c.observed_from, c.observed_to);
    // A modelled figure's window is the lookback the model read, not the period
    // the amount covers — the model's own distinction, kept in the wording.
    if (win) parts.push(c.estimated ? "Modelled from usage that " + win + "." : "Figure " + win + ".");
    if (c.match_key) parts.push("Matched to this resource by \"" + c.match_key + "\" rather than by ARN.");
    var flag = "";
    if (c.caveats && c.caveats.length > 0) {
      flag = "†";
      parts.push("Lower bound — " + c.caveats.join(" "));
    }
    var off = (c.currency || "") !== currency;
    if (off) {
      parts.push("Reported in " + (c.currency ? c.currency : "no stated currency") +
        ", so it is excluded from every total on this page and sorts last.");
    } else if (!decParse(c.amount)) {
      off = true;
      parts.push("This amount is not a decimal number, so it is excluded from every total on this page " +
        "rather than guessed at.");
    }
    return { text: formatMoney(c.amount, c.currency), dim: off, flag: flag, title: parts.join(" ") };
  }

  // ---- Header metadata ------------------------------------------------------
  var gen = new Date(meta.generated_at);
  var genEl = document.getElementById("gen-at");
  genEl.textContent = isNaN(gen.getTime())
    ? String(meta.generated_at || "")
    : gen.toLocaleString(undefined, { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
  genEl.title = String(meta.generated_at || "");

  var verEl = document.getElementById("brand-ver");
  if (meta.version) { verEl.textContent = String(meta.version); } else { verEl.hidden = true; }

  var accounts = meta.accounts || [];
  var regions = meta.regions || [];
  document.getElementById("chip-scope").textContent =
    plural(accounts.length, "account") + " · " + plural(regions.length, "region") + " · " + plural(total, "resource");

  // ---- Failures banner (honesty ledger) ------------------------------------
  if (failures.length > 0) {
    document.getElementById("failures-banner").hidden = false;
    document.getElementById("failures-title").textContent =
      "Incomplete coverage — " + failures.length + " scan unit" + (failures.length === 1 ? "" : "s") + " failed";
    var list = document.getElementById("failures-list");
    failures.forEach(function (f) {
      var li = el("li");
      li.appendChild(el("span", "mono", [f.account_id, f.region, f.service].filter(Boolean).join(" / ")));
      li.appendChild(document.createTextNode(" — "));
      li.appendChild(el("span", "failure-error", f.error));
      list.appendChild(li);
    });
  }

  // ---- Empty state ----------------------------------------------------------
  // A census with no resources needs none of the rest of the page, and — the
  // reason this check sits above the decode rather than after it — no census
  // block either. Returning here means an empty report never touches
  // DecompressionStream, so it opens in any browser.
  if (total === 0) {
    document.getElementById("empty-state").hidden = false;
    ["cost-section", "stats-section", "spend-section", "engines-section", "table-section"].forEach(function (id) {
      document.getElementById(id).hidden = true;
    });
    return;
  }

  // Tier filter composes with the free-text filter via AND.
  var activeTier = null;

  // ---- Stat strip -----------------------------------------------------------
  var noOwner = summary.no_owner || 0;
  var eolCount = summary.eol || 0;
  var exposedCount = summary.exposed || 0;

  var kpisEl = document.getElementById("kpis");
  function addStat(label, num, sub, opts) {
    var box = el("div", "rr-kpi");
    box.appendChild(el("div", "rr-kpi-label", label));
    var numEl = el("div", "rr-kpi-num", num);
    if (opts && opts.denom) numEl.appendChild(el("span", "rr-kpi-denom", opts.denom));
    box.appendChild(numEl);
    var subCls = "rr-kpi-sub";
    if (opts && opts.ok) subCls += " rr-kpi-sub-ok";
    if (opts && opts.bad) subCls += " rr-kpi-sub-bad";
    box.appendChild(el("div", subCls, sub));
    kpisEl.appendChild(box);
  }
  addStat("Resources", total.toLocaleString(),
    plural(summary.types || 0, "type") + " · " + plural(summary.accounts || 0, "account"));
  addStat("Attribution score", String(Math.round((100 * TIER_BY_KEY.full.count) / total)),
    "owner + environment tagged", { denom: "/100" });
  addStat("Untagged", TIER_BY_KEY.untagged.count.toLocaleString(), "no owner or environment");
  addStat("Missing owner", noOwner.toLocaleString(), Math.round((100 * noOwner) / total) + "% of all resources");
  addStat("End-of-life", eolCount.toLocaleString(),
    eolCount === 0 ? "no EOL engine or runtime versions" : "support ended",
    eolCount === 0 ? { ok: true } : { bad: true });
  addStat("Exposed", exposedCount.toLocaleString(),
    exposedCount === 0 ? "no exposure flags" : "public, unencrypted, or no backups",
    exposedCount === 0 ? { ok: true } : { bad: true });
  addStat("Scan failures", failures.length.toLocaleString(),
    failures.length === 0 ? "every scan unit succeeded" : "see incomplete-coverage details above",
    { ok: failures.length === 0 });

  // ---- Attribution bar + legend ---------------------------------------------
  //
  // The bar is weighted by spend whenever spend is known, because "8% of the
  // resources" and "41% of the bill" are different arguments and only the second
  // one gets acted on. It falls back to counts when nothing is priced, and the
  // legend always says which of the two is on screen.
  var barEl = document.getElementById("attr-bar");
  var legendEl = document.getElementById("attr-legend");

  function renderAttrBar() {
    var spend = COST.active ? tierSpend(resources) : null;
    var weighted = !!(spend && spend.total && spend.total.u > 0n);
    var noun = methodBasis().noun;
    var byKey = {};
    if (spend) spend.tiers.forEach(function (t) { byKey[t.key] = t; });

    var bars = document.createDocumentFragment();
    var legend = document.createDocumentFragment();
    TIERS.forEach(function (t) {
      var s = byKey[t.key] || null;
      var countPart = plural(t.count, "resource") + " (" + Math.round((100 * t.count) / total) + "% of resources)";
      var spendPart = "";
      if (weighted) {
        spendPart = s && s.sum
          ? decPercent(s.sum, spend.total) + "% of priced " + noun + " (" +
            formatMoney(decFormat(s.sum), COST.currency) + " from " + plural(s.priced, "resource") + ")"
          : "no priced resource";
      }
      var detail = t.label + " · " + (weighted ? spendPart + " · " + countPart : countPart);

      t._seg = null;
      var width = weighted ? decShare(s && s.sum, spend.total) : t.count;
      if (width > 0) {
        var seg = el("div", "rr-attr-seg");
        seg.style.background = t.color;
        seg.style.flex = width + " 1 0%";
        seg.title = detail;
        seg.addEventListener("click", function () { setTier(t.key); });
        t._seg = seg;
        bars.appendChild(seg);
      }

      var btn = el("button", "rr-legend-item");
      btn.type = "button";
      btn.setAttribute("aria-pressed", "false");
      btn.title = detail;
      var dot = el("span", "rr-legend-dot");
      dot.style.background = t.color;
      btn.appendChild(dot);
      btn.appendChild(el("span", "", t.label));
      btn.appendChild(el("span", "rr-legend-count", t.count.toLocaleString()));
      btn.addEventListener("click", function () { setTier(t.key); });
      t._leg = btn;
      legend.appendChild(btn);
    });

    legend.appendChild(el("span", "rr-legend-note", weighted
      ? "weighted by " + methodLabel(COST.method) + " " + noun + (COST.currency ? " in " + COST.currency : "")
      : "weighted by resource count"));

    barEl.replaceChildren(bars);
    legendEl.replaceChildren(legend);
    syncTierUI();
  }

  function setTier(key) {
    activeTier = activeTier === key ? null : key;
    syncTierUI();
    rebuild(false);
  }

  function syncTierUI() {
    TIERS.forEach(function (t) {
      var dimmed = activeTier !== null && activeTier !== t.key;
      if (t._seg) t._seg.style.opacity = dimmed ? "0.25" : "1";
      if (t._leg) {
        t._leg.style.opacity = dimmed ? "0.25" : "1";
        t._leg.setAttribute("aria-pressed", activeTier === t.key ? "true" : "false");
      }
    });
  }

  // ---- Engines ----------------------------------------------------------------
  // Already folded, ranked and deduplicated in Go. Services with no platform
  // concept (object stores, networking, storage) contribute no row rather than
  // piling into an "(unknown)" bucket that would imply blueprint failed to read
  // something.
  var engineRows = summary.platforms || [];

  var engRowsEl = document.getElementById("engine-rows");
  var max = 1;
  engineRows.forEach(function (e) { if (e.count > max) max = e.count; });
  var engFrag = document.createDocumentFragment();
  engineRows.forEach(function (e) {
    var row = el("div", "rr-eng-row");
    var entity = el("div", "rr-eng-entity");
    var dot = el("span", "rr-eng-dot");
    dot.style.background = hashColor(e.service);
    entity.appendChild(dot);
    entity.appendChild(el("span", "rr-eng-name", e.name));
    row.appendChild(entity);
    row.appendChild(el("div", "rr-eng-family",
      e.versions > 0 ? e.service + " · " + plural(e.versions, "version") : e.service));
    var barWrap = el("div", "rr-bar-wrap");
    var bar = el("div", "rr-bar");
    bar.style.width = Math.round((e.count / max) * 100) + "%";
    barWrap.appendChild(bar);
    row.appendChild(barWrap);
    row.appendChild(el("div", "rr-eng-total", e.count.toLocaleString()));
    row.appendChild(el("div", "rr-eng-regions", plural(e.regions || 0, "region")));
    engFrag.appendChild(row);
  });
  engRowsEl.replaceChildren(engFrag);
  document.getElementById("engines-sub").textContent =
    plural(engineRows.length, "platform") + " · " + plural(summary.services || 0, "service");
  // Nothing in scope reports a platform — hide the section instead of showing
  // an empty chart.
  var enginesHaveRows = engineRows.length > 0;
  if (!enginesHaveRows) document.getElementById("engines-section").hidden = true;

  // ---- Cost overlay ---------------------------------------------------------

  // Spend filter, composing with the tier and free-text filters via AND.
  var activeService = null;

  // stampCosts pins the active method's figure onto each row. _cost is the
  // record AWS returned; _costDec is that amount as an exact decimal, and only
  // when it is in the currency being totalled — a figure in another currency
  // still shows on its own row but is never added to anything.
  function stampCosts() {
    COST.priced = 0;
    COST.caveated = 0;
    resources.forEach(function (r) {
      var c = COST.method ? costFor(r, COST.method) : null;
      r._cost = c;
      r._costDec = null;
      // Why this row is absent from the totals, and "" when it is not there to
      // explain. A row can be missing from a total for reasons that are not the
      // same kind of thing: AWS never priced it, or AWS priced it and this page
      // will not add the figure up. groupReasons reads this so the breakdown
      // can tell those apart, because calling the second one an absence
      // contradicts the amount printed in the row itself.
      r._costGap = "absent";
      if (!c) return;
      var sameCurrency = (c.currency || "") === COST.currency;
      if (sameCurrency) r._costDec = decParse(c.amount);
      if (r._costDec) {
        r._costGap = "";
        COST.priced++;
        if (c.caveats && c.caveats.length > 0) COST.caveated++;
      } else {
        r._costGap = sameCurrency ? "unparsed" : "offCurrency";
      }
    });
  }

  // stampSources pins every source's figure onto each row, one cell per method,
  // for the table columns that show them side by side. Unlike stampCosts this
  // does not move when the selected basis moves — a Cost Explorer column shows
  // Cost Explorer whichever source the totals are using — so it runs once.
  //
  // Each cell is judged against its own source's dominant currency, and dec is
  // null unless the amount both matches that currency and parses. dec exists
  // only to order that one column; it is never added across columns, and there
  // is no code path that could, because no caller reads two of them at once.
  function stampSources() {
    COST.currencyBy = {};
    COST.methods.forEach(function (m) { COST.currencyBy[m.method] = dominantCurrency(m); });
    resources.forEach(function (r) {
      var by = {};
      (r.costs || []).forEach(function (c) {
        var method = c.method || "";
        // First figure wins for a method, matching costFor, which the hero and
        // the old single column both read through. A resource priced twice by
        // one source is rare and the alternative is picking a winner by size.
        if (by[method]) return;
        var dec = (c.currency || "") === (COST.currencyBy[method] || "") ? decParse(c.amount) : null;
        by[method] = { rec: c, dec: dec };
      });
      r._costBy = by;
    });
  }

  // initCost folds the rows into COST. It runs once, in the decode
  // continuation; everything the metadata alone can say about cost is already
  // on screen by then (see costAttemptedFromMeta).
  function initCost() {
    COST.methods = methodCounts(resources);
    var hasReasons = resources.some(function (r) { return !!r.cost_unavailable; });
    COST.attempted = COST.attempted || COST.methods.length > 0 || hasReasons;
    stampSources();
    if (COST.methods.length > 0) {
      // Default to whichever source priced the most resources; ties go to
      // Cost Explorer, which reports what was billed rather than what a model
      // expects to be billed.
      COST.method = COST.methods[0].method;
      COST.currency = dominantCurrency(COST.methods[0]);
    }
    stampCosts();
    COST.counted = true;
    COST.active = COST.priced > 0;
  }

  // costAttemptedFromMeta is the half of "was cost asked for" the metadata
  // block knows on its own: a rollup or a resource-level report in the file
  // means a cost pass ran, whatever the census turns out to hold. It is set at
  // boot so the panels fed by those two reports can paint before — and, if the
  // decode fails, without — the rows.
  function costAttemptedFromMeta() {
    COST.attempted = !!costReport || !!resourceCostReport;
  }

  function setMethod(m) {
    if (m === COST.method) return;
    var entry = null;
    COST.methods.forEach(function (e) { if (e.method === m) entry = e; });
    if (!entry) return;
    COST.method = m;
    COST.currency = dominantCurrency(entry);
    activeService = null;
    stampCosts();
    COST.active = COST.priced > 0;
    renderCostViews();
    renderAttrBar();
    syncCostHeader();
    rebuild(false);
  }

  // The noun is "issue" and not "caveat" because caveat already names something
  // else on this page: a cost record's own caveats field, counted as
  // COST.caveated and rendered as the † lower-bound line below the table. Two
  // different counts of the same-named thing, a banner apart, is a misreading
  // waiting to happen — and the smaller one looks like a correction of the
  // larger. This number is exactly what coverageIssues returned, so the title
  // names that.
  function coverageTitle(n) {
    // COST.counted, not just COST.active: before the census is read, "no
    // resource-level cost data" is a guess dressed as a headline.
    if (COST.counted && !COST.active) return "No resource-level cost data — spend cannot be ranked, attributed, or broken down";
    return "Partial cost coverage — " + plural(n, "issue") + " affecting the figures below";
  }

  // coverageIssues is everything standing between this page and a complete
  // picture of the bill, each with the fix where there is one. Silence here
  // means the cost pass reported nothing missing, not that nothing was checked.
  function coverageIssues() {
    var issues = [];
    var rollups = (costReport && costReport.currencies) || [];

    if (costReport && rollups.length === 0) {
      issues.push({
        text: "Cost Explorer returned no usable rollup, so this report has no account total. A partial rollup is " +
          "discarded rather than published, because once written down it is indistinguishable from a complete one.",
        fix: "Grant ce:GetCostAndUsage and rerun; if the query was truncated, scan fewer accounts at a time."
      });
    }
    if (costReport && costReport.estimated === true) {
      issues.push({
        text: "AWS still marks the rollup estimated: these figures move as AWS restates them and will not reconcile " +
          "to an invoice.",
        fix: ""
      });
    }
    rollups.forEach(function (c) {
      var a = decParse(c.attributed);
      var u = decParse(c.unattributed);
      var t = decParse(c.total);
      if (!a || !u || !t || decCmp(decAdd(a, u), t) !== 0) {
        issues.push({
          text: "The " + (c.currency || "unlabelled") + " rollup does not add up: " + reconcileLine(c) + ".",
          fix: ""
        });
      }
    });

    // Three states, not two. Until the census is read there is no per-resource
    // finding to report, and if it cannot be read there never will be — which
    // is itself the finding, and a different one from AWS having priced
    // nothing.
    if (!COST.counted) {
      if (censusUnreadable) {
        issues.push({
          text: "The inventory in this file could not be read, so nothing here is per-resource: spend cannot be " +
            "ranked per resource, attributed to an owner, or split by service. What is still shown — the account " +
            "total, the reconciliation trail, what the questions cost — comes from the report's metadata, which " +
            "read fine.",
          fix: "The reason is printed where the table would be. If it names DecompressionStream, open this file in " +
            "Safari 16.4+, Firefox 113+ or Chrome 80+; otherwise rerun the scan to regenerate it."
        });
      }
    } else if (!COST.active) {
      issues.push({
        text: "No resource-level figure reached any resource, so spend cannot be ranked per resource, attributed to " +
          "an owner, or split by service. The account total above, where present, is all AWS reported.",
        fix: "Switch on resource-level data in Billing preferences and rerun with --costs --cost-resources, or " +
          "enroll the account in Cost Optimization Hub (cost-optimization-hub:ListRecommendations)."
      });
    } else if (COST.priced < total) {
      issues.push({
        text: (total - COST.priced).toLocaleString() + " of " + plural(total, "resource") + " carry no " +
          methodLabel(COST.method) + " figure" + (COST.currency ? " in " + COST.currency : "") +
          ", so every total on this page is a floor rather than the bill.",
        fix: ""
      });
    }
    // Whichever of those two sentences was printed, the resources it counted are
    // accounted for here, and the exclusions are worded as exclusions. They used
    // to be two standalone bullets sitting outside the breakdown, which said the
    // same thing twice on a run with both — once as its own sentence and once,
    // wrongly, inside "no cost pass recorded a cause".
    //
    // The census keeps one explanation per resource, whichever collector
    // recorded it, so a recorded group is reported as what the cost pass said
    // rather than as an account of the active source's gap.
    if (COST.counted && COST.priced < total) {
      groupReasons(resources.filter(function (r) { return !r._costDec; })).forEach(function (g) {
        var text;
        if (g.kind === "recorded") {
          text = plural(g.count, "resource") + " — the cost pass recorded: " + g.reason;
        } else if (g.kind === "offCurrency") {
          text = plural(g.count, "resource") + " were priced in another currency and are excluded from every " +
            "total here: this tool holds no exchange rate and will not invent one. Each still shows its own " +
            "amount on its own row.";
        } else if (g.kind === "unparsed") {
          text = plural(g.count, "figure") + " could not be read as a decimal amount and " +
            (g.count === 1 ? "was" : "were") + " left out of every total rather than guessed at.";
        } else {
          text = plural(g.count, "resource") +
            " — no cost pass recorded a cause, and Cost Explorer names none rather than guess at one";
        }
        issues.push({ text: text, fix: "" });
      });
    }
    probes.forEach(function (p) {
      if (p.outcome === "rows" && !p.truncated) return;
      issues.push({ text: p.service + ": " + probeLine(p), fix: probeFix(p.outcome) });
    });
    return issues;
  }

  function renderCostBanner() {
    var section = document.getElementById("cost-banner");
    // No cost pass ran, so there is no coverage to report on. A run without
    // --costs is not a run with missing cost data.
    if (!COST.attempted) { section.hidden = true; return; }
    var issues = coverageIssues();
    if (issues.length === 0) { section.hidden = true; return; }
    document.getElementById("cost-banner-title").textContent = coverageTitle(issues.length);
    var frag = document.createDocumentFragment();
    issues.forEach(function (i) {
      var li = el("li", "", i.text);
      if (i.fix) {
        li.appendChild(document.createElement("br"));
        li.appendChild(el("span", "failure-error", "fix: " + i.fix));
      }
      frag.appendChild(li);
    });
    document.getElementById("cost-banner-list").replaceChildren(frag);
    section.hidden = false;
  }

  // untaggedShare is the sub-line under the untagged tile, kept out of the tile
  // so the branch that refuses to state a percentage can be tested without a
  // DOM. A share of a whole that is zero is not a small share; it is not a
  // share, and decPercent says so by returning null — which concatenates into
  // the literal word "null" if it is used unguarded.
  //
  // The test is the one renderAttrBar uses rather than a null check, because a
  // whole that nets negative would yield a signed number here while the bar has
  // already refused to weight by spend at all, and the two must not disagree.
  // Zero is reached by an estate of stored zeros and, more often, by credits
  // cancelling out the charges — where a real untagged amount still sits above
  // this line, so the missing percentage is explained rather than dropped.
  function untaggedShare(sum, whole, nUntagged, nPriced, noun, currency) {
    var counts = nUntagged.toLocaleString() + " of " + nPriced.toLocaleString() + " priced resources";
    if (!whole) return counts;
    if (whole.u <= 0n) {
      return counts + " · priced " + noun + " totals " + formatMoney(decFormat(whole), currency) +
        ", so no share of it can be stated";
    }
    return decPercent(sum, whole) + "% of priced " + noun + " · " + counts;
  }

  // heroCoverage is the sub-line under the spend tile. The gap it names belongs
  // to the active source in the active currency and has to be worded that way:
  // priced excludes resources the *other* source priced, resources priced in
  // another currency, and amounts that would not parse — all of them things AWS
  // did report, two of which are printed in the Cost column of the very rows
  // this line is describing. The coverage banner already says it correctly;
  // this is the same sentence.
  function heroCoverage(priced, total) {
    return "across " + priced.toLocaleString() + " of " + plural(total, "resource");
  }

  // heroGap is the other half of that sentence, split out because a source tile
  // is titled by the source: repeating "carry no Cost Explorer figure" under a
  // tile already headed "Cost Explorer" spends a line saying nothing. It keeps
  // the two absences apart — a resource this source never priced is a different
  // fact from one it priced in a currency nothing here can add — because the
  // second is an amount printed in the row below and calling it missing would
  // contradict the page.
  function heroGap(s, whole) {
    var missing = whole - s.priced - s.offCurrency;
    var bits = [];
    if (missing > 0) bits.push(missing.toLocaleString() + " carry no figure from this source");
    if (s.offCurrency > 0) {
      bits.push(s.offCurrency.toLocaleString() + " priced in another currency, added to nothing");
    }
    return bits.join(" · ");
  }

  // renderCostHero returns how many tiles it drew, so the caller can hide the
  // section rather than leave an empty panel where money should be.
  function renderCostHero() {
    var frag = document.createDocumentFragment();
    var tiles = 0;

    function tile(label, amount, currency, subs) {
      tiles++;
      var box = el("div", "rr-cost-tile");
      box.appendChild(el("div", "rr-cost-label", label));
      var num = el("div", "rr-cost-num", amount);
      if (currency) num.appendChild(el("span", "rr-cost-cur", currency));
      box.appendChild(num);
      subs.forEach(function (s) {
        if (!s || !s.text) return;
        box.appendChild(el("div", "rr-cost-sub" + (s.bad ? " rr-cost-sub-bad" : ""), s.text));
      });
      frag.appendChild(box);
    }

    // One tile per source, side by side, in the order methodCounts fixed: the
    // source that priced the most resources first, Cost Explorer breaking ties.
    // Neither tile is a share of the other and there is no tile underneath them
    // holding a combined figure, because there is no window both cover.
    COST.methods.forEach(function (m) {
      var s = sourceSummary(m.method);
      if (!s || !s.total) return;
      var b = methodBasis(m.method);
      // A modelled monthly rate has no billed period to name, so it says what it
      // is rather than borrowing the other source's window. Its metric is that
      // same sentence — methodBasis returns "modelled monthly rate" for it — so
      // appending it as well printed the phrase twice in one line.
      var basisLine = b.monthly
        ? "modelled monthly rate · not an amount AWS billed"
        : "billed" + (b.window ? " · " + b.window : "") + (b.metric ? " · " + b.metric : "");
      tile(methodLabel(m.method), decFormat(s.total), s.currency, [
        { text: basisLine },
        { text: heroCoverage(s.priced, total) },
        { text: heroGap(s, total) }
      ]);
    });

    var spend = COST.active ? tierSpend(resources) : null;
    var basis = methodBasis();

    if (spend && spend.total) {
      var untagged = null;
      spend.tiers.forEach(function (t) { if (t.key === "untagged") untagged = t; });
      var unowned = decSum(resources
        .filter(function (r) { return !r.owner && r._costDec; })
        .map(function (r) { return r._costDec; }));
      var hasUntagged = !!(untagged && untagged.sum);
      tile("Untagged " + basis.noun, hasUntagged ? decFormat(untagged.sum) : "—", hasUntagged ? COST.currency : "", [
        {
          text: !hasUntagged
            ? "no priced resource is missing both owner and environment"
            : untaggedShare(untagged.sum, spend.total, untagged.priced, COST.priced, basis.noun, COST.currency),
          bad: hasUntagged && untagged.sum.u > 0n
        },
        { text: unowned ? "no owner tag at all: " + formatMoney(decFormat(unowned), COST.currency) : "" },
        // Unlike the source tiles beside it, this one is a total, so it has to
        // pick a single basis — and say which, because with two sources on the
        // page an unlabelled total is a number the reader cannot place. The
        // control that changes it sits directly underneath.
        { text: COST.methods.length > 1 ? "totalled from " + methodLabel(COST.method) + " figures" : "" }
      ]);
    }

    var rollups = (costReport && costReport.currencies) || [];
    var roll = rollups.length > 0 ? rollups[0] : null;
    rollups.forEach(function (c) { if (c.currency === COST.currency) roll = c; });
    if (roll) {
      var rollWin = costReport.window || null;
      var rollLabel = rollWin ? (rollWin.label || "") + costPartialSuffix(rollWin) : "";
      tile("Account total" + (rollLabel ? " · " + rollLabel : ""), roll.total, roll.currency, [
        { text: "attributed " + roll.attributed + " · unattributed " + roll.unattributed },
        {
          text: (costReport.metric ? costReport.metric + " · " : "") +
            plural((costReport.accounts || []).length, "account") +
            (costReport.estimated === true ? " · AWS still marks this estimated" : ""),
          bad: costReport.estimated === true
        },
        { text: rollups.length > 1 ? plural(rollups.length - 1, "further currency") + " in the details below" : "" }
      ]);
    }

    document.getElementById("cost-hero").replaceChildren(frag);
    return tiles;
  }

  // renderCoverage draws one track per source: how much of the census that
  // source could put a figure on. Both figures are already in the table, one
  // column each, so this answers the question the columns cannot — how much of
  // the estate each source actually saw — before the reader starts trusting
  // either total.
  //
  // Separate tracks, not one split track. A single bar divided between the two
  // sources would read as a whole made of two parts, and they are not parts of
  // anything: the same resource is routinely priced by both, so the segments
  // would overlap and the bar would sum past its own denominator. Each source
  // gets the full census as its denominator and is scored against it alone.
  function renderCoverage() {
    var box = document.getElementById("cost-coverage");
    if (!COST.counted || COST.methods.length === 0 || total === 0) { box.hidden = true; return; }
    var frag = document.createDocumentFragment();
    frag.appendChild(el("div", "rr-cov-head", "Cost coverage · share of the " +
      total.toLocaleString() + " censused resources each source could price"));

    COST.methods.forEach(function (m) {
      var b = methodBasis(m.method);
      var row = el("div", "rr-cov-row");

      var name = el("div", "");
      name.appendChild(el("div", "rr-cov-name", methodLabel(m.method)));
      name.appendChild(el("div", "rr-cov-basis", b.monthly ? "modelled · monthly rate" : "billed · closed window"));
      row.appendChild(name);

      // m.priced is the count of resources this source returned any figure for,
      // which is the honest denominator question — currency and parsing are
      // this page's problems with the figure, not the source's failure to
      // report one. The hero tiles carry that finer split.
      var pct = decShare({ u: BigInt(m.priced), e: 0 }, { u: BigInt(total), e: 0 });
      var track = el("div", "rr-cov-track");
      var fill = el("div", "rr-cov-fill");
      fill.style.width = pct + "%";
      track.appendChild(fill);
      track.setAttribute("role", "img");
      track.setAttribute("aria-label", methodLabel(m.method) + " priced " + m.priced.toLocaleString() +
        " of " + total.toLocaleString() + " resources");
      track.title = methodLabel(m.method) + " returned a figure for " + m.priced.toLocaleString() +
        " of " + plural(total, "resource") + " (" + decPercent({ u: BigInt(m.priced), e: 0 }, { u: BigInt(total), e: 0 }) + "%)";
      row.appendChild(track);

      row.appendChild(el("div", "rr-cov-count", m.priced.toLocaleString() + " / " + total.toLocaleString()));
      frag.appendChild(row);
    });

    // Priced by nobody: the rows where every source came back empty. Counted
    // from the rows rather than subtracted from the tracks above, because a
    // resource priced by both sources is in both of them and the arithmetic
    // would double-count it straight into a negative.
    var none = 0;
    resources.forEach(function (r) { if (!(r.costs || []).length) none++; });
    if (none > 0) {
      frag.appendChild(el("div", "rr-cov-none", none.toLocaleString() + " of " +
        total.toLocaleString() + " priced by neither source — each row states why in the cost columns"));
    }

    box.replaceChildren(frag);
    box.hidden = false;
  }

  function renderMethodSelector() {
    var box = document.getElementById("cost-method");
    // One source is not a choice, and a control that cannot change anything is
    // just something else to read.
    if (COST.methods.length < 2) { box.hidden = true; return; }
    var frag = document.createDocumentFragment();
    // The scope is in the label. This control no longer hides half the data —
    // both sources have their own hero tile, their own coverage track and their
    // own table column — so all it still decides is which single basis the
    // things that must pick one are computed from: the untagged total, the
    // attribution bar, Spend by service, and grouped rows.
    frag.appendChild(el("span", "rr-method-label", "Totals and rankings use"));
    COST.methods.forEach(function (m) {
      var btn = el("button", "rr-method-btn", methodLabel(m.method));
      btn.type = "button";
      btn.setAttribute("aria-pressed", m.method === COST.method ? "true" : "false");
      btn.title = "Totals have to pick one source: Cost Explorer bills a closed window and Cost Optimization Hub " +
        "models a monthly rate, so adding them would publish a figure neither reported. Both sources stay visible " +
        "per resource in the table whichever is selected here.";
      btn.addEventListener("click", function () { setMethod(m.method); });
      frag.appendChild(btn);
    });
    box.replaceChildren(frag);
    box.hidden = false;
  }

  // The cost prose splits by whether a sentence is a finding about *this*
  // census or a standing explanation of the instrument. Only findings stay on
  // the page unprompted; the rest is identical in every report blueprint has
  // ever written, and five paragraphs of it under the headline figures is how
  // the disclosures stopped being read at all. Nothing is deleted — moving a
  // caveat behind a disclosure would be a quieter way of dropping it — it moves
  // one click away, into a summary that says what is under it.
  function renderCostNote() {
    var frag = document.createDocumentFragment();
    if (COST.methods.length > 1) {
      frag.appendChild(el("p", "", "Two sources priced this census and both are shown per resource. They are never " +
        "added: " + methodLabel("ce") + " reports what AWS billed over a closed window, " +
        methodLabel("coh") + " a modelled rate for a month that has not happened."));
    }
    if (COST.caveated > 0) {
      frag.appendChild(el("p", "", "† " + plural(COST.caveated, "figure") + " below " +
        (COST.caveated === 1 ? "is a lower bound" : "are lower bounds") + ": they cover part of a resource's charges " +
        "and are ranked alongside complete ones, because a table has a single order. Each row's tooltip carries the " +
        "source's own wording."));
    }
    document.getElementById("cost-note").replaceChildren(frag);
  }

  // renderCostMore carries everything renderCostNote used to print inline.
  function renderCostMore() {
    var frag = document.createDocumentFragment();
    // The commitment disclosure describes the figure actually in front of the
    // reader. Cost Explorer's metric name says nothing true about a Cost
    // Optimization Hub rate, so the method goes with it and the note picks its
    // own wording rather than being handed a blank metric to interpret.
    var metric = (resourceCostReport && resourceCostReport.metric) || (costReport && costReport.metric) || "";
    frag.appendChild(el("p", "", commitmentNote(metric, COST.method)));
    frag.appendChild(el("p", "", NO_ESTIMATE_NOTE));
    // Stated whenever Cost Optimization Hub priced anything, not only when it is
    // the selected basis: its figures are now on the page in their own hero tile
    // and their own table column regardless of what the selector says, so the
    // sentence explaining what they are has to be there regardless too.
    if (COST.methods.some(function (m) { return m.method === "coh"; })) {
      var lookback = methodWindow("coh");
      var over = lookback
        ? ", modelled from usage from " + costWindowStamp(lookback.from) + " up to " +
          costWindowStamp(lookback.to) + " UTC"
        : "";
      frag.appendChild(el("p", "", "Cost Optimization Hub figures are modelled monthly rates for each resource's " +
        "current configuration, not amounts AWS billed" + over + ". The lookback is what the model read, not a " +
        "period anything was charged for; the rate itself already covers a whole month, so these figures are never " +
        "added to or ranked against the billed windows elsewhere on this page."));
    }
    if (COST.active && (costReport && costReport.currencies || []).length > 0) {
      frag.appendChild(el("p", "", "The account total and the per-resource figures are two meters over two different " +
        "windows and are not meant to add up: the rollup covers the whole bill, the per-resource figures cover only " +
        "what AWS reported against a resource this census could see."));
    }
    // Counted before the append: replaceChildren moves the fragment's children
    // out of it, so reading the length afterwards always sees zero and the
    // disclosure would never open.
    var n = frag.childNodes.length;
    document.getElementById("cost-more-body").replaceChildren(frag);
    document.getElementById("cost-more").hidden = n === 0;
  }

  function renderRecon() {
    var frag = document.createDocumentFragment();
    var any = false;

    function entry(term, lines) {
      var text = lines.filter(Boolean);
      if (text.length === 0) return;
      any = true;
      frag.appendChild(el("dt", "", term));
      text.forEach(function (t) { frag.appendChild(el("dd", "", t)); });
    }

    ((costReport && costReport.currencies) || []).forEach(function (c) {
      var cur = c.currency || "unlabelled currency";
      entry("Cost Explorer rollup · " + cur, [formatMoney(c.total, c.currency) + "   " + reconcileLine(c)]);
      entry("By service · " + cur, (c.services || []).map(function (s) {
        return s.name + " " + formatMoney(s.amount, c.currency);
      }));
      entry("Unattributed · " + cur, (c.unattributed_records || []).map(function (s) {
        return s.name + " " + formatMoney(s.amount, c.currency);
      }));
      entry("By account · " + cur, (c.accounts || []).map(function (s) {
        return s.name + " " + formatMoney(s.amount, c.currency);
      }));
    });

    // Both windows are listed whichever source is active: the panel is the audit
    // trail for the data the run collected, not a view of the current selection.
    var win = resourceCostReport && resourceCostReport.window;
    entry("Resource-level window", [win ? costWindowSentence(win.start, win.end) : ""]);
    var lookback = methodWindow("coh");
    entry("Modelled-from window", [lookback
      ? "Cost Optimization Hub modelled its monthly rates from usage from " + costWindowStamp(lookback.from) +
        " up to " + costWindowStamp(lookback.to) + " UTC; the rate each figure states covers a month."
      : ""]);
    entry("Resource-level probes", probes.map(function (p) { return p.service + ": " + probeLine(p); }));

    // Two of the four kinds are exclusions rather than absences, and they are
    // worded as such: AWS did price the resource, this page is declining to add
    // that figure into a total. Calling either "no cause recorded" would sit in
    // an audit panel contradicting the amount printed in the row above it.
    //
    // Gated on COST.counted because this panel paints before the census
    // decodes and again if the decode fails: `resources` is null in the first
    // case and stays null in the second, and an empty breakdown would read as
    // "every resource has a figure" on a page that has no resources.
    var unpriced = COST.counted ? resources.filter(function (r) { return !r._costDec; }) : [];
    entry("Why a figure is missing", groupReasons(unpriced).map(function (g) {
      var why;
      if (g.kind === "recorded") why = g.reason;
      else if (g.kind === "offCurrency") why = "priced in another currency, so excluded from the totals";
      else if (g.kind === "unparsed") why = "amount could not be read as a decimal, so excluded from the totals";
      else why = "no cause recorded";
      return plural(g.count, "resource") + " — " + why;
    }));

    var meters = [];
    if (costReport) meters.push(meterLine("rollup", costReport.meter));
    if (resourceCostReport) meters.push(meterLine("resource-level", resourceCostReport.meter));
    entry("What asking cost", meters);

    document.getElementById("cost-recon-body").replaceChildren(frag);
    // The panel hides itself, from its own section, rather than riding along
    // inside #cost-section. That section hides when the hero drew no tiles, and
    // [hidden] takes every descendant with it — which is exactly the run this
    // panel exists for: cost was asked for, AWS was paid per request for the
    // asking, and nothing came back. Nested, the one run the reader was billed
    // for was the one run that never said what they paid.
    document.getElementById("cost-audit-section").hidden = !any;
  }

  // meterLine reports what this report's own questions cost, including when the
  // answer is nothing: a reader deciding whether to rerun deserves the number.
  function meterLine(which, meter) {
    if (!meter) return "";
    var line = which + ": " + plural(meter.requests || 0, "request");
    if (meter.estimated_charge_usd) line += ", " + formatMoney(meter.estimated_charge_usd, "USD");
    if (meter.capped) line += " ⚠ request budget reached, so some services were never asked";
    return line;
  }

  function renderSpend() {
    var section = document.getElementById("spend-section");
    if (!COST.active) {
      section.hidden = true;
      document.getElementById("engines-section").hidden = !enginesHaveRows;
      return;
    }
    var basis = methodBasis();
    var groups = serviceSpend(resources);
    var top = null;
    groups.forEach(function (s) { if (s.sum && (!top || decCmp(s.sum, top) > 0)) top = s.sum; });

    var frag = document.createDocumentFragment();
    var pricedServices = 0;
    groups.forEach(function (s) {
      if (s.sum) pricedServices++;
      var row = el("button", "rr-eng-row rr-spend-row");
      row.type = "button";
      row.setAttribute("aria-pressed", activeService === s.service ? "true" : "false");
      row.style.opacity = (activeService !== null && activeService !== s.service) ? "0.35" : "1";
      row.title = s.sum
        ? formatMoney(decFormat(s.sum), COST.currency) + " across " + s.priced.toLocaleString() + " of " +
          plural(s.count, "resource") + ". Click to filter the inventory to this service."
        : "No " + methodLabel(COST.method) + " figure for any of this service's " + plural(s.count, "resource") +
          ", which is not the same as costing nothing. Click to filter the inventory to this service.";
      row.addEventListener("click", function () { setSpendFilter(s.service); });

      var entity = el("div", "rr-eng-entity");
      var dot = el("span", "rr-eng-dot");
      dot.style.background = hashColor(s.service);
      entity.appendChild(dot);
      entity.appendChild(el("span", "rr-eng-name", s.service || "(no service reported)"));
      row.appendChild(entity);

      var engines = engineBreakdown(s);
      row.appendChild(el("div", "rr-eng-family",
        plural(s.count, "resource") + (engines ? " · " + engines : "")));

      var barWrap = el("div", "rr-bar-wrap");
      if (s.sum && top) {
        var bar = el("div", "rr-bar");
        bar.style.width = decShare(s.sum, top) + "%";
        barWrap.appendChild(bar);
      }
      row.appendChild(barWrap);

      var amount = el("div", "rr-spend-amount");
      if (s.sum) {
        amount.textContent = formatMoney(decFormat(s.sum), COST.currency);
      } else {
        amount.className = "rr-spend-amount dim";
        amount.textContent = "—";
      }
      row.appendChild(amount);
      row.appendChild(el("div", "rr-eng-regions", s.priced.toLocaleString() + " of " + s.count.toLocaleString()));
      frag.appendChild(row);
    });

    document.getElementById("spend-rows").replaceChildren(frag);
    // The heading follows the source: ranking modelled monthly rates is not
    // ranking spend, and one word is the whole difference between the two.
    document.getElementById("spend-title").textContent =
      basis.monthly ? "Modelled monthly cost by service" : "Spend by service";
    document.getElementById("spend-sub").textContent =
      pricedServices.toLocaleString() + " of " + plural(groups.length, "service") + " have a " +
      methodLabel(COST.method) + " figure · this sums only what AWS reported per resource, so it does not equal " +
      "the account total";
    section.hidden = false;
    // The platform breakdown moves into each service row rather than staying a
    // section of its own.
    document.getElementById("engines-section").hidden = true;
  }

  function setSpendFilter(service) {
    activeService = activeService === service ? null : service;
    renderSpend();
    rebuild(false);
  }

  function renderCostViews() {
    renderCostBanner();
    var tiles = renderCostHero();
    renderMethodSelector();
    renderCoverage();
    renderCostNote();
    renderCostMore();
    renderRecon();
    document.getElementById("cost-section").hidden = !COST.attempted || tiles === 0;
    renderSpend();
  }

  // ---- Inventory table ----------------------------------------------------
  var COLUMNS = [
    { key: "name", label: "Name" },
    { key: "service", label: "Service" },
    { key: "_engine", label: "Platform" },
    { key: "_class", label: "Class" },
    { key: "_sizeBytes", label: "Size", num: true },
    { key: "region", label: "Region" },
    { key: "account_id", label: "Account" },
    { key: "environment", label: "Environment" },
    { key: "owner", label: "Owner" },
    { key: "status", label: "Status" }
  ];
  // Cost sits second and opens sorted descending: it is the report's organizing
  // principle, not a trailing column, and the first question asked of a ranking
  // is what is at the top of it.
  //
  // The column's existence is decided once, by whether the run collected any
  // figures at all, and never by the active method — switching sources must not
  // add or drop a column out from under the header row.
  //
  // It also has to be decided here, before the census has decoded, because this
  // is where the header row is built. So it comes from the metadata block Go
  // writes rather than from COST, which cannot know anything until there are
  // rows to count: summary.costed is the same question asked of the same
  // resources one process earlier.
  var costColumn = summary.costed === true;
  // One column per source, both always present, neither hidden behind the
  // selector. A reader comparing "AWS billed 12.40 for this over a fortnight"
  // against "the model says 31.00 a month for it as configured" is doing the
  // most useful thing on the page, and it used to take two clicks and a memory.
  //
  // They stay two columns and never merge into one: there is no cell that could
  // hold both without either summing them or dropping one, and each sorts on its
  // own. Sorting is per column for the same reason — a combined order would rank
  // a billed fortnight against a modelled month.
  //
  // costMethods is read from the metadata block for the same reason costColumn
  // is: COST knows nothing until the census decodes, and by then the header row
  // is on screen. Both fall back to a single unlabelled column if an older
  // payload has costed but no cost_methods, which keeps the money visible
  // rather than vanishing it on a payload mismatch.
  var costMethods = costColumn ? (summary.cost_methods || []).slice() : [];
  if (costColumn && costMethods.length === 0) costMethods = [""];
  costMethods.forEach(function (m, i) {
    COLUMNS.splice(1 + i, 0, {
      key: "_costSort:" + m,
      label: costColumnLabel(m),
      num: true,
      cost: true,
      method: m,
      startDir: -1
    });
  });
  var GROUP_FIELD = { service: "service", type: "type", engine: "_engine", environment: "environment", region: "region", account: "account_id" };

  var filterEl = document.getElementById("filter");
  var groupEl = document.getElementById("groupby");
  var countEl = document.getElementById("row-count");
  var tbody = document.getElementById("rows");
  // The table opens ranked by money when there is money to rank by — decided in
  // the boot continuation, once the rows exist and initCost has found out
  // whether anything in them actually priced.
  var sortKey = null;
  var sortDir = 1;

  var headRow = document.getElementById("head-row");
  COLUMNS.forEach(function (c) {
    var th = document.createElement("th");
    th.scope = "col";
    if (c.num) th.className = "num";
    var btn = el("button", "th-btn");
    btn.type = "button";
    var lab = el("span", "th-lab", c.label);
    if (c.cost) {
      c._sub = el("span", "th-sub");
      lab.appendChild(c._sub);
    }
    btn.appendChild(lab);
    var dir = el("span", "dir");
    btn.appendChild(dir);
    btn.addEventListener("click", function () {
      var start = c.startDir || 1;
      if (sortKey === c.key) {
        if (sortDir === start) { sortDir = -start; } else { sortKey = null; sortDir = 1; }
      } else {
        sortKey = c.key;
        sortDir = start;
      }
      updateSortIndicators();
      rebuild(false);
    });
    th.appendChild(btn);
    headRow.appendChild(th);
    c._th = th;
    c._dir = dir;
  });

  // syncCostHeader states the window and the meter in the column header itself.
  // A cost with no window named beside it is a number without a question.
  // Each cost column describes its own source. The head says Billed or
  // Modelled; the sub-line underneath is where the source is named in full, so
  // the two columns are never told apart by a single word the reader has to
  // remember the meaning of.
  function syncCostHeader() {
    COLUMNS.forEach(function (c) {
      if (!c.cost || !c._sub) return;
      var m = c.method === undefined ? COST.method : c.method;
      var basis = methodBasis(m);
      var bits = [methodLabel(m)];
      if (basis.metric) bits.push(basis.metric);
      if (basis.window) bits.push(basis.window);
      var cur = COST.currencyBy[m] || (m === COST.method ? COST.currency : "");
      if (cur) bits.push(cur);
      c._sub.textContent = bits.join(" · ");
      c._th.title = basis.monthly
        ? methodLabel(m) + " models a monthly rate for each resource as it is configured now. It is not an " +
          "amount AWS billed, and it is never added to or ranked against the billed column beside it."
        : methodLabel(m) + " reports what AWS billed over a closed window. It is never added to or ranked " +
          "against a modelled rate.";
    });
  }

  function updateSortIndicators() {
    COLUMNS.forEach(function (c) {
      var active = c.key === sortKey;
      c._dir.textContent = active ? (sortDir === 1 ? "▲" : "▼") : "";
      c._th.setAttribute("aria-sort", active ? (sortDir === 1 ? "ascending" : "descending") : "none");
    });
  }

  // Size is the only numeric column, and a resource whose service never
  // reported a size is not a zero-byte resource. Folding absence to zero
  // interleaved the two, so sorting by Size buried genuinely empty tables among
  // rows that simply had nothing to say about their size. null keeps them
  // apart; compareRows puts them in their own block.
  // costSortMethod pulls the source out of a cost column's key, or null for any
  // other column. Each cost column sorts on its own source alone: an order that
  // interleaved a billed fortnight with a modelled month would be a ranking
  // across two questions, which is the one thing this page will not publish.
  function costSortMethod(key) {
    if (typeof key !== "string" || key.indexOf("_costSort:") !== 0) return null;
    return key.slice("_costSort:".length);
  }

  function costSortDec(r, key) {
    var m = costSortMethod(key);
    if (m === null) return undefined;
    var cell = (r._costBy || {})[m];
    return cell ? cell.dec : null;
  }

  function sortValue(r, key) {
    if (key === "_sizeBytes") return typeof r._sizeBytes === "number" ? r._sizeBytes : null;
    // A decimal object or null. Never a number: a charge is compared with
    // decCmp, digit by digit, and 0.00 is an object like any other amount.
    var dec = costSortDec(r, key);
    if (dec !== undefined) return dec;
    return String(r[key] || "").toLowerCase();
  }

  // nullRank separates "AWS did not report this" from every value it did. It is
  // applied outside the direction multiply, so an absence sorts last whichever
  // way the arrow points: reversing a ranking must not promote silence to the
  // top of it. It is also what keeps a real zero — a 0-byte table, a 0.00
  // charge — ranked as the finding it is instead of tied with the unknown.
  function nullRank(r, key) {
    if (key === "_sizeBytes") return (r._sizeBytes === null || r._sizeBytes === undefined) ? 1 : 0;
    var dec = costSortDec(r, key);
    if (dec !== undefined) return dec ? 0 : 1;
    return 0;
  }

  // compareRows orders by the column value; equal engine names are tie-broken
  // by engine version compared numerically, so "15.4" sorts after "9.6".
  function compareRows(a, b, key) {
    var av = sortValue(a, key);
    var bv = sortValue(b, key);
    // Absences are partitioned by nullRank before this point, so one missing
    // side means both are missing and there is nothing left to order them by.
    // This function must not cancel the direction multiply itself: nullRank
    // already sits outside it, and doing it in both places negates twice and
    // sends the unreported rows back to the top of a descending sort.
    if (av === null || av === undefined || bv === null || bv === undefined) return 0;
    if (costSortMethod(key) !== null) return decCmp(av, bv);
    if (typeof av === "number") return av - bv;
    if (av !== bv) return av < bv ? -1 : 1;
    if (key === "_engine") {
      return String(a._engineVersion || "").localeCompare(String(b._engineVersion || ""), undefined, { numeric: true });
    }
    return 0;
  }

  function cellOrDash(v, cls) {
    var c = el("td", cls);
    if (v) {
      c.textContent = v;
    } else {
      c.textContent = "—";
      c.className = (cls ? cls + " " : "") + "dim";
    }
    return c;
  }

  // Environment tags are colored by normalized bucket so "prod", "prd" and
  // "production" read as the same thing; unrecognized values stay neutral.
  var ENV_BUCKETS = [
    { cls: "tag-purple", re: /^(prod|prd|production|live)$/ },
    { cls: "tag-cyan", re: /^(stag(e|ing)?|stg|pre-?prod|uat)$/ },
    { cls: "tag-blue", re: /^(dev|development)$/ },
    { cls: "tag-pink", re: /^(test(ing)?|qa|sandbox|sbx)$/ }
  ];
  function envClass(v) {
    v = v.toLowerCase();
    for (var i = 0; i < ENV_BUCKETS.length; i++) {
      if (ENV_BUCKETS[i].re.test(v)) return ENV_BUCKETS[i].cls;
    }
    return "";
  }

  // Status tags map AWS lifecycle states to a traffic light: healthy green,
  // gone-wrong red, intentionally-off amber, in-transition blue.
  function statusClass(v) {
    v = v.toLowerCase();
    if (/^(available|active|running|healthy)$/.test(v)) return "tag-green";
    if (/fail|error|incompatible|inaccessible|storage-full|delet/.test(v)) return "tag-red";
    if (/stopp|paus|inactive/.test(v)) return "tag-amber";
    if (/creat|modif|backing|start|reboot|upgrad|updat|maint|resiz|renam|migrat|snapshot|configur/.test(v)) return "tag-blue";
    return "";
  }

  function tagCell(v, cls, withDot) {
    if (!v) return cellOrDash("", "");
    var td = document.createElement("td");
    var tag = el("span", "tag" + (cls ? " " + cls : ""));
    if (withDot) tag.appendChild(el("span", "tag-dot"));
    tag.appendChild(el("span", "", v));
    td.appendChild(tag);
    return td;
  }

  // costCell renders one of three states and never the fourth: an amount AWS
  // reported, an absence AWS explained, and an absence it did not. A resource
  // with no figure is not a free resource, so it gets a dash and a tooltip, not
  // a zero.
  function costCell(r, m) {
    var t = costText(r, m);
    var td = el("td", "num mono");
    if (t.text) {
      td.appendChild(document.createTextNode(t.text));
      if (t.flag) td.appendChild(el("span", "cost-flag", t.flag));
      if (t.dim) td.className = "num mono dim";
    } else {
      td.className = "num mono dim";
      td.textContent = "—";
    }
    if (t.title) td.title = t.title;
    return td;
  }

  function buildRow(r) {
    var tr = document.createElement("tr");

    var name = el("td", "mono");
    var tierDot = el("span", "tier-dot");
    tierDot.style.background = TIER_BY_KEY[r._tier].color;
    tierDot.title = TIER_BY_KEY[r._tier].label;
    name.appendChild(tierDot);
    name.appendChild(document.createTextNode(r.name || ""));
    if (r.arn) name.title = r.arn;
    tr.appendChild(name);
    // One cell per source, in the same order and at the same offset COLUMNS
    // spliced the headers.
    costMethods.forEach(function (m) { tr.appendChild(costCell(r, m)); });

    var svc = el("td", "", "");
    svc.appendChild(el("span", "", r.service || ""));
    if (r._typeShort) {
      svc.appendChild(document.createTextNode(" "));
      var typeEl = el("span", "sub", r._typeShort);
      typeEl.title = r.type;
      svc.appendChild(typeEl);
    }
    tr.appendChild(svc);

    var eng = el("td", "", "");
    eng.appendChild(el("span", "", r._engine));
    if (r._engineVersion) {
      eng.appendChild(document.createTextNode(" "));
      eng.appendChild(el("span", "sub", r._engineVersion));
    }
    if (r.eol) {
      eng.appendChild(document.createTextNode(" "));
      var eol = el("span", "tag tag-red", "EOL");
      if (r.eol_date) eol.title = "end of life: " + r.eol_date;
      eng.appendChild(eol);
    }
    tr.appendChild(eng);

    tr.appendChild(cellOrDash(r._class, "mono"));

    var sizeTd = cellOrDash(formatSize(r._sizeBytes), "num");
    var observed = formatObserved(r._sizeAsOf);
    if (observed && typeof r._sizeBytes === "number") {
      sizeTd.appendChild(el("span", "sub", observed));
      sizeTd.title = "observed " + r._sizeAsOf +
        " — CloudWatch publishes this daily, so it can be up to 48h behind, and it counts noncurrent versions and incomplete multipart uploads";
    }
    tr.appendChild(sizeTd);

    tr.appendChild(cellOrDash(r.region, "mono"));
    tr.appendChild(cellOrDash(r.account_id, "mono"));
    tr.appendChild(tagCell(r.environment, envClass(r.environment || ""), false));
    tr.appendChild(cellOrDash(r.owner, ""));
    var statusTd = tagCell(r.status, statusClass(r.status || ""), true);
    if (r.publicly_accessible === true) {
      statusTd.appendChild(document.createTextNode(" "));
      statusTd.appendChild(el("span", "tag tag-red", "public"));
    }
    if (r.encrypted === false) {
      statusTd.appendChild(document.createTextNode(" "));
      statusTd.appendChild(el("span", "tag tag-amber", "unencrypted"));
    }
    if (r._backup === 0) {
      statusTd.appendChild(document.createTextNode(" "));
      statusTd.appendChild(el("span", "tag tag-amber", "no backups"));
    }
    tr.appendChild(statusTd);
    return tr;
  }

  // Every way the table can be narrowed, in one place. A spend bar counts: the
  // group headers print census-wide totals from Go and are suppressed while a
  // filter is on, and a total over the whole census sitting beside a count of
  // one service's rows invites the reader to divide one by the other.
  function filterActive() {
    return activeTier !== null || activeService !== null || filterEl.value.trim() !== "";
  }

  function currentRows() {
    var q = filterEl.value.trim().toLowerCase();
    var terms = q ? q.split(/\s+/) : null;
    var rows = [];
    for (var i = 0; i < resources.length; i++) {
      var r = resources[i];
      if (activeTier && r._tier !== activeTier) continue;
      // A spend bar narrows the table to one service. Compared against "" and
      // not for truthiness, so clicking the "(no service reported)" bar filters
      // to exactly those rows instead of clearing the filter.
      if (activeService !== null && (r.service || "") !== activeService) continue;
      if (terms) {
        var hay = hayOf(r);
        var matched = true;
        for (var j = 0; j < terms.length; j++) {
          if (hay.indexOf(terms[j]) === -1) { matched = false; break; }
        }
        if (!matched) continue;
      }
      rows.push(r);
    }
    if (sortKey) {
      rows.sort(function (a, b) {
        // Absence is ranked outside the direction multiply on purpose: a
        // resource AWS reported nothing for belongs at the bottom of the
        // ascending list and the bottom of the descending one.
        var ra = nullRank(a, sortKey);
        var rb = nullRank(b, sortKey);
        if (ra !== rb) return ra - rb;
        return sortDir * compareRows(a, b, sortKey);
      });
    }
    return rows;
  }

  // ---- Grouping -------------------------------------------------------------
  //
  // Past a few hundred resources the table opens grouped and closed. A census
  // is not a list anybody reads top to bottom; the first useful thing it can
  // say is where the estate actually is — "ec2 · 1,284 resources · 41,208.00
  // USD" — and fifty thousand rows say that in about twenty-five lines. The
  // reader opens the part they came for.
  var GROUP_COLLAPSE_ABOVE = 500;

  // Explicit open/closed state, per dimension, for the groups the reader has
  // actually clicked. Everything else follows defaultOpen().
  var openByDim = Object.create(null);
  var preFilterOpen = null;
  var allOpen = false;
  var filterWasActive = false;

  function defaultOpen() { return allOpen || total <= GROUP_COLLAPSE_ABOVE; }

  function isOpen(dim, value) {
    var m = openByDim[dim];
    if (m && Object.prototype.hasOwnProperty.call(m, value)) return m[value];
    return defaultOpen();
  }

  function setOpen(dim, value, open) {
    if (!openByDim[dim]) openByDim[dim] = Object.create(null);
    openByDim[dim][value] = open;
  }

  // A filter opens every group for as long as it is on. Three matches hiding
  // inside three closed groups looks exactly like no matches at all, which
  // would make the search box lie. The reader's own collapsing is put aside
  // rather than thrown away, and comes back when the filter clears — so the
  // carets always describe what is really on screen, and clicking one while
  // filtering still works.
  function syncFilterCollapse() {
    var now = filterActive();
    if (now === filterWasActive) return;
    filterWasActive = now;
    if (now) {
      preFilterOpen = openByDim;
      openByDim = Object.create(null);
      allOpen = true;
    } else {
      openByDim = preFilterOpen || Object.create(null);
      preFilterOpen = null;
      allOpen = false;
    }
  }

  // costIndex maps a group value to the spend Go attributed to it. The totals
  // describe the whole census, so they are only ever shown — and only ever
  // sorted on — when no filter is narrowing the view; printing a census-wide
  // total beside a filtered count would invite the reader to divide one by the
  // other.
  var costIndexCache = Object.create(null);
  function costIndex(dim) {
    if (costIndexCache[dim]) return costIndexCache[dim];
    var out = Object.create(null);
    ((summary.groups || {})[dim] || []).forEach(function (g) {
      out[g.value] = g;
    });
    costIndexCache[dim] = out;
    return out;
  }

  // Group totals are decimal strings and they are compared as decimals, digit
  // by digit. Money that reached this page exactly is not going to be pushed
  // through a float for the sake of a sort. This runs only when the summary
  // says one method and one currency priced every resource in the census, so a
  // group has at most one total to compare and no group is ranked on a total
  // that covers only part of it. It still selects that total through
  // groupBucket rather than taking the first one listed: the ordering has to
  // be of the figures on screen, and asserting the invariant here costs a
  // comparison and removes a way for the two to drift apart.
  function compareGroupCost(a, b) {
    var ab = groupBucket(a), bb = groupBucket(b);
    var av = ab ? ab.amount : null;
    var bv = bb ? bb.amount : null;
    if (av === null && bv === null) return 0;
    if (av === null) return -1;
    if (bv === null) return 1;
    return compareDecimal(av, bv);
  }

  function compareDecimal(a, b) {
    var an = a.charAt(0) === "-";
    var bn = b.charAt(0) === "-";
    if (an !== bn) return an ? -1 : 1;
    var m = compareMagnitude(an ? a.slice(1) : a, bn ? b.slice(1) : b);
    return an ? -m : m;
  }

  // Longer whole part wins; same length compares lexicographically, which for
  // equal-length digit strings is the same as comparing the numbers. Fractions
  // are zero-padded to a common length so "1.5" and "1.45" compare correctly.
  function compareMagnitude(a, b) {
    var ap = a.split(".");
    var bp = b.split(".");
    var aw = ap[0].replace(/^0+(?=\d)/, "");
    var bw = bp[0].replace(/^0+(?=\d)/, "");
    if (aw.length !== bw.length) return aw.length < bw.length ? -1 : 1;
    if (aw !== bw) return aw < bw ? -1 : 1;
    var af = ap[1] || "";
    var bf = bp[1] || "";
    var width = Math.max(af.length, bf.length);
    while (af.length < width) af += "0";
    while (bf.length < width) bf += "0";
    if (af !== bf) return af < bf ? -1 : 1;
    return 0;
  }

  // flatten turns the filtered rows into the single sequence the body paints:
  // group headers interleaved with the rows of the groups that are open. It is
  // one array so that virtualization has one thing to index into.
  function flatten(rows, groupBy) {
    if (groupBy === "none" || !GROUP_FIELD[groupBy]) return rows;
    var field = GROUP_FIELD[groupBy];
    var groups = Object.create(null);
    var order = [];
    for (var i = 0; i < rows.length; i++) {
      var v = String(rows[i][field] || "");
      if (!Object.prototype.hasOwnProperty.call(groups, v)) {
        groups[v] = [];
        order.push(v);
      }
      groups[v].push(rows[i]);
    }

    var costs = costIndex(groupBy);
    // Whether the headers of this grouping carry a cost slot at all. Not
    // COST.active, which is false exactly when the selected source priced
    // nothing — the state the slot exists to report. What makes the slot
    // meaningless is Go having attributed no spend to this dimension at all:
    // then no header on screen carries a figure, a blank one contrasts with
    // nothing, and labelling every group restates the coverage banner once per
    // group.
    var costDim = Object.keys(costs).length > 0;
    var showCost = costDim && !filterActive();
    var byCost = showCost && summary.cost_sortable === true;
    order.sort(function (a, b) {
      if (a === "") return 1;
      if (b === "") return -1;
      if (byCost) {
        var c = compareGroupCost(costs[b], costs[a]);
        if (c !== 0) return c;
      }
      return groups[b].length - groups[a].length || (a < b ? -1 : a > b ? 1 : 0);
    });

    var out = [];
    for (var k = 0; k < order.length; k++) {
      var value = order[k];
      var open = isOpen(groupBy, value);
      out.push({
        _group: value,
        _dim: groupBy,
        _rows: groups[value].length,
        // _spend is what Go attributed to this group, and it is absent for a
        // group no source priced. _costSlot is the separate question of
        // whether this header speaks about cost at all, which stays true for
        // that group: absent is the thing it has to say.
        _spend: showCost ? (costs[value] || null) : null,
        _costSlot: showCost,
        _open: open
      });
      if (open) {
        var members = groups[value];
        for (var m = 0; m < members.length; m++) out.push(members[m]);
      }
    }
    return out;
  }

  var COST_METHODS = {
    ce: "Cost Explorer — what AWS billed over a closed window",
    coh: "Cost Optimization Hub — modelled monthly rate for the current configuration"
  };

  // groupBucket picks the one total a group header is allowed to print: the
  // (method, currency) pair the reader selected as the report's source.
  //
  // A group carries one total per pair its members were priced in. Printing
  // them side by side sets a billed Cost Explorer window total next to a
  // modelled Cost Optimization Hub monthly rate, same currency suffix,
  // separated by a middot and distinguishable only by hovering — which is the
  // ranking the rest of this page refuses to do, performed in the one place
  // the eye goes first. It also strands the header on whatever the summary
  // happened to list first while every row beneath it changes source, so a
  // group whose figure comes from the source the reader just switched away
  // from keeps printing money over a column of "—".
  function groupBucket(spend) {
    var costs = (spend && spend.costs) || [];
    for (var i = 0; i < costs.length; i++) {
      if (costs[i].method === COST.method && costs[i].currency === COST.currency) {
        return costs[i];
      }
    }
    return null;
  }

  // A total containing a caveated figure prices a component rather than a whole
  // resource, so it is a lower bound and is marked as one instead of passing
  // for the full bill.
  function appendGroupCost(btn, spend) {
    var wrap = el("span", "group-cost");
    var c = groupBucket(spend);

    // Nothing on screen priced this group. Saying so beats printing nothing: a
    // blank header sitting among headers that carry figures reads as free, and
    // this group is not free — it is unpriced by the source currently on
    // screen.
    //
    // Two different groups arrive here and both say the same sentence, because
    // it is the same sentence: one carries figures from a source or currency
    // the reader is not looking at (spend is Go's entry, with no bucket for
    // this pair), the other was priced by nothing at all (Go emits no entry for
    // it, so spend is null). Only the tooltip separates them, because only the
    // tooltip can afford to — telling the second reader to switch source would
    // send them looking for a figure that is not anywhere in the file.
    if (!c) {
      var none = el("span", "group-partial", "no " + methodLabel(COST.method) + " figure");
      none.title = spend
        ? "nothing in this group was priced by " + methodLabel(COST.method) +
          (COST.currency ? " in " + COST.currency : "") +
          ". Another source or currency priced it — switch source above to see."
        : "no source in this report priced anything in this group.";
      wrap.appendChild(none);
      btn.appendChild(wrap);
      return;
    }

    var span = el("span", "", (c.qualified ? "≥ " : "") + c.amount + " " + c.currency);
    span.title = COST_METHODS[c.method] || c.method;
    if (c.qualified) {
      span.title += " — lower bound: at least one figure in this total prices a component, not the whole resource";
    }
    wrap.appendChild(span);

    // The count beside the group name is every member; the total is only over
    // the ones this source priced. Where those differ the header says so,
    // because the two read as a pair and the pair would otherwise state that
    // the whole group costs what its priced fraction costs. The fraction is
    // this bucket's own reach, not the group's: a member the other source
    // priced is still a member this total does not cover.
    if (c.priced < spend.total) {
      var note = el("span", "group-partial",
        "over " + c.priced + " of " + spend.total);
      note.title = "no " + methodLabel(COST.method) + " figure for " + (spend.total - c.priced) +
        " of " + spend.total + " resources in this group — the total is a lower " +
        "bound, and groups are ordered by resource count rather than spend " +
        "while any group is short";
      wrap.appendChild(note);
    }
    btn.appendChild(wrap);
  }

  function buildGroupRow(g) {
    var tr = el("tr", "group-row");
    var td = document.createElement("td");
    td.colSpan = COLUMNS.length;
    var btn = el("button", "group-btn");
    btn.type = "button";
    btn.setAttribute("aria-expanded", g._open ? "true" : "false");
    btn.appendChild(el("span", "group-caret", g._open ? "▼" : "▶"));
    btn.appendChild(el("span", "group-name",
      g._group || (g._dim === "environment" ? "no environment tag" : "(none)")));
    btn.appendChild(el("span", "group-count", plural(g._rows, "resource")));
    if (g._costSlot) appendGroupCost(btn, g._spend);
    btn.addEventListener("click", function () {
      setOpen(g._dim, g._group, !isOpen(g._dim, g._group));
      rebuild(true);
    });
    td.appendChild(btn);
    tr.appendChild(td);
    return tr;
  }

  // ---- Virtualized body -----------------------------------------------------
  //
  // The body holds the rows that are on screen and nothing else.
  //
  // One row is about twenty-five DOM nodes. Fifty thousand of them is over a
  // million nodes — long enough to lay out that the browser offers to kill the
  // tab — and the old renderer rebuilt every one of them on every keystroke.
  // Here the body holds about sixty rows whatever the census size, with a
  // spacer above and below standing in for the rest so the scrollbar keeps its
  // true length and a scroll position keeps its true meaning.
  //
  // Group headers are taller than data rows, so the visible window cannot be
  // found by dividing. Each rebuild fills a prefix-sum table of row offsets in
  // one pass and each paint binary-searches it. Row heights come from CSS, so
  // they are measured off the first painted window rather than hard-coded.
  var OVERSCAN = 8;
  var ROW_H = 31;
  var GROUP_H = 34;
  // Measured per kind, not once overall. A census that opens grouped and
  // collapsed paints nothing but group headers, so a single flag would take the
  // first window as proof of both and leave the data-row height at its guess
  // for the session — in exactly the view this virtualization exists to serve.
  var measuredRow = false;
  var measuredGroup = false;

  var wrap = document.getElementById("table-wrap");
  var view = [];
  var offsets = null;
  var firstPainted = -1;
  var lastPainted = -1;

  function isGroup(item) { return item._group !== undefined; }
  function heightOf(item) { return isGroup(item) ? GROUP_H : ROW_H; }

  function spacer() {
    var tr = el("tr", "spacer");
    var td = document.createElement("td");
    td.colSpan = COLUMNS.length;
    // The height lives on an inner div: a td's own height is a minimum that
    // the table layout is free to ignore, a block box's is not.
    var box = document.createElement("div");
    td.appendChild(box);
    tr.appendChild(td);
    tr._box = box;
    return tr;
  }
  var topSpacer = spacer();
  var bottomSpacer = spacer();

  function setSpacer(tr, px) {
    tr._box.style.height = px + "px";
    tr.hidden = px <= 0;
  }

  function buildOffsets() {
    var n = view.length;
    offsets = new Float64Array(n + 1);
    var y = 0;
    for (var i = 0; i < n; i++) {
      offsets[i] = y;
      y += heightOf(view[i]);
    }
    offsets[n] = y;
  }

  // indexAt returns the last entry starting at or before y.
  function indexAt(y) {
    var lo = 0;
    var hi = view.length - 1;
    if (hi < 0) return 0;
    while (lo < hi) {
      var mid = (lo + hi + 1) >> 1;
      if (offsets[mid] <= y) lo = mid; else hi = mid - 1;
    }
    return lo;
  }

  function noMatchRow() {
    var tr = el("tr", "no-match");
    var td = el("td", "dim", "No resources match the current filters.");
    td.colSpan = COLUMNS.length;
    tr.appendChild(td);
    return tr;
  }

  // The wrapper caps its height in CSS but never sets one, so clientHeight is
  // whatever it currently holds. Sizing the window from it measures the body
  // about to be replaced — on first paint, an empty one — and paints far too
  // few rows to cover the screen, leaving a blank strip until the next scroll
  // nudges it. The cap is the height the window actually has to fill, so it is
  // read from CSS once and refreshed when the viewport changes.
  var heightCap = 0;
  function measureCap() {
    var cap = parseFloat(getComputedStyle(wrap).maxHeight);
    heightCap = cap > 0 ? cap : 0;
  }
  function viewportHeight() { return Math.max(wrap.clientHeight, heightCap); }

  function paint(force) {
    if (!offsets) return;
    var n = view.length;
    if (n === 0) {
      firstPainted = lastPainted = -1;
      tbody.replaceChildren(noMatchRow());
      return;
    }
    var top = wrap.scrollTop;
    var first = Math.max(0, indexAt(top) - OVERSCAN);
    var last = Math.min(n - 1, indexAt(top + viewportHeight()) + OVERSCAN);
    if (!force && first === firstPainted && last === lastPainted) return;
    firstPainted = first;
    lastPainted = last;

    var sawRow = false;
    var sawGroup = false;
    var frag = document.createDocumentFragment();
    setSpacer(topSpacer, offsets[first]);
    frag.appendChild(topSpacer);
    for (var i = first; i <= last; i++) {
      var item = view[i];
      if (isGroup(item)) sawGroup = true; else sawRow = true;
      frag.appendChild(isGroup(item) ? buildGroupRow(item) : buildRow(item));
    }
    setSpacer(bottomSpacer, offsets[n] - offsets[last + 1]);
    frag.appendChild(bottomSpacer);
    tbody.replaceChildren(frag);

    // Only measure when this window holds a kind that has never been measured.
    // Asking otherwise would force a layout on every scroll frame for a number
    // already known.
    if ((sawRow && !measuredRow) || (sawGroup && !measuredGroup)) measureRowHeights();
  }

  // Row heights are a guess until a row exists to measure: CSS decides them,
  // and so do the reader's font settings and zoom level. Each kind is asked
  // once, off the first painted window that contains one, and the offset table
  // is rebuilt if the guess was wrong. The flags are set before the repaint, so
  // it cannot come back here and loop.
  function measureRowHeights() {
    var changed = false;
    var rows = tbody.children;
    for (var i = 0; i < rows.length; i++) {
      var tr = rows[i];
      var h = tr.offsetHeight;
      if (!h || tr.classList.contains("spacer")) continue;
      if (tr.classList.contains("group-row")) {
        measuredGroup = true;
        if (h !== GROUP_H) { GROUP_H = h; changed = true; }
      } else {
        measuredRow = true;
        if (h !== ROW_H) { ROW_H = h; changed = true; }
      }
    }
    if (!changed) return;
    buildOffsets();
    paint(true);
  }

  function rebuild(keepScroll) {
    if (!resources) return;
    syncFilterCollapse();
    var rows = currentRows();
    view = flatten(rows, groupEl.value);
    buildOffsets();
    if (!keepScroll) wrap.scrollTop = 0;
    paint(true);
    countEl.textContent = rows.length.toLocaleString() + " of " + total.toLocaleString() + " resources";
  }

  var scrollQueued = false;
  wrap.addEventListener("scroll", function () {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(function () {
      scrollQueued = false;
      paint(false);
    });
  });
  // A taller viewport shows more rows, so both the cap and the window have to
  // be recomputed even though nothing scrolled.
  window.addEventListener("resize", function () { measureCap(); paint(true); });

  var debounceTimer = null;
  filterEl.addEventListener("input", function () {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () { rebuild(false); }, 150);
  });
  groupEl.addEventListener("change", function () { rebuild(false); });

  // ---- Boot -----------------------------------------------------------------
  //
  // Two passes, because the page has two arrivals. Everything Go folded into
  // the metadata block paints now; everything that has to read the rows waits
  // for the census to decode. Cost is split across both: the Cost column has to
  // exist before the header row is built, but what is in it — which source, in
  // which currency, over which window, and how much of the estate it reached —
  // is a fold over the rows and cannot be known until they arrive.
  syncTierUI();
  // Weighted by count for now. When the rows land and something in them is
  // priced, this is called again and redraws weighted by spend.
  renderAttrBar();
  // The cost panels paint from the metadata now rather than waiting for the
  // census, because most of what they hold was never in the census: the
  // account rollup, its per-service and per-account breakdowns, both collection
  // windows, and what the questions cost are all folded into the plain JSON
  // block above. Drawing them only in the decode continuation made every one
  // of them a hostage of the inventory — a browser that cannot ungzip, or a
  // file whose two blocks disagree, would erase the account total while it sat
  // readable in the same file. They are drawn again when the rows land, with
  // the per-resource half filled in; until then nothing here claims a fact
  // about rows nobody has read (see COST.counted).
  costAttemptedFromMeta();
  renderCostViews();
  updateSortIndicators();
  measureCap();
  if (total > GROUP_COLLAPSE_ABOVE) groupEl.value = "service";

  // The controls stay inert until there is something to control. Everything
  // above the table is already painted at this point; only the inventory is
  // waiting on the decode.
  filterEl.disabled = true;
  groupEl.disabled = true;
  countEl.textContent = "reading " + total.toLocaleString() + " resources…";

  decodeCensus().then(function (table) {
    resources = readTable(table);
    // The summary and the census block are folded from the same snapshot by
    // the same run. If they disagree about how many resources there are, one
    // of them is wrong and there is no way to tell which — so the page says so
    // rather than showing a table it cannot vouch for.
    if (resources.length !== total) {
      throw new Error("This report is inconsistent: it summarizes " +
        total.toLocaleString() + " resources but its inventory holds " +
        resources.length.toLocaleString() + ".");
    }
    precompute();
    // After precompute, which is what puts _tier on a row, and before anything
    // reads a cost off one.
    initCost();
    // The table opens ranked by money when there is money to rank by. Set here
    // rather than beside the other sort state, because "is anything priced" is
    // a fact about the rows.
    //
    // It opens on the selected basis's column, which is the source that priced
    // the most of the census — the one ranking that describes the most of it.
    // Falling back to the first column keeps a sort rather than none if the
    // selected method somehow has no column of its own.
    if (COST.active && costMethods.length > 0) {
      var opening = costMethods.indexOf(COST.method) >= 0 ? COST.method : costMethods[0];
      sortKey = "_costSort:" + opening;
      sortDir = -1;
    }
    renderCostViews();
    renderAttrBar();
    syncCostHeader();
    updateSortIndicators();
    filterEl.disabled = false;
    groupEl.disabled = false;
    rebuild(false);
  }).catch(failCensus);
})();
</script>
</body>
</html>
