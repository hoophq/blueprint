    }
    return null;
  }

  // methodCounts tallies resources, not figures: a resource priced twice by one
  // method still counts once, so the number a reader compares against the census
  // is a count of things they can point at.
  function methodCounts(rows) {
    var byMethod = {};
    var order = [];
    rows.forEach(function (r) {
      var costs = r.costs || [];
      var seenMethod = {};
      var seenPair = {};
      costs.forEach(function (c) {
        var method = c.method || "";
        var cur = c.currency || "";
