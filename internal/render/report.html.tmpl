  }

  // methodWindow returns the observation window every figure from one source
  // shares, or null when they do not all share one. One window can be stated as
  // a fact about the whole set; a mixture cannot be collapsed into one without
  // claiming coverage no single figure has, so in that case the per-row tooltips
  // carry each figure's own window and the summary states none.
  function methodWindow(method) {
    var seen = null;
    var mixed = false;
    resources.forEach(function (r) {
      (r.costs || []).forEach(function (c) {
        if ((c.method || "") !== method) return;
        // Both ends or nothing, which is what Go's sharedWindow does: a figure
        // with one endpoint places no period, and the joined key only catches
        // the case where *both* are missing. A half-placed window rendered as
        // "modelled from usage from  up to 2026-07-01 UTC" — a real date given
        // an origin the source never stated. Cost Optimization Hub can emit
        // exactly that, so it is refused here rather than formatted around.
        if (!c.observed_from || !c.observed_to) { mixed = true; return; }
        var key = c.observed_from + "|" + c.observed_to;
        if (seen === null) { seen = key; } else if (seen !== key) { mixed = true; }
      });
    });
