<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>blueprint report</title>
<style>
  /* blueprint report — dark, single file, no external resources:
     font-family names only, everything inline.

     Two rules govern this file, both enforced by internal/render/html_test.go,
     and both by scanning the finished page for literal text. That matters when
     writing comments here: the scan cannot tell a note about a forbidden
     construct from the construct itself, so this one describes them without
     spelling any of them out. The list itself lives in html_test.go.

     1. Nothing loads from off the machine. No stylesheet or script may be
        pulled in by reference, in markup or from CSS, and the one href in the
        page points at the project's own repository. Everything the report
        needs is inline, because it is opened from disk, offline, by someone
        who may have no reason to trust an outbound request.

     2. No HTML comments, anywhere. The sequence that opens one — like the one
        that closes a script tag — ends the HTML parser's script-data state,
        and either would let census content escape into markup. The template
        writes its notes as CSS comments (here) and JavaScript comments
        (below) instead. */
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    min-height: 100vh;
    background: #0c0c0c;
    color: #F7F7F7;
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 14px;
    line-height: 1.45;
  }
  [hidden] { display: none !important; }

  .rr-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 32px 64px;
  }

  /* ── Header ── */
  .rr-head { padding-bottom: 18px; border-bottom: 1px solid rgba(247, 247, 247, 0.07); }
  .rr-head-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .rr-brand { display: flex; align-items: center; gap: 8px; }
  .rr-brand-name {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 600;
    color: rgba(247, 247, 247, 0.75);
  }
  .rr-brand-ver {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(247, 247, 247, 0.35);
    background: rgba(247, 247, 247, 0.06);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 5px;
    padding: 2px 7px;
  }
  .rr-gen {
    margin-left: auto;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.35);
  }
  .rr-meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .rr-meta-chip {
    font-size: 12px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.55);
    background: rgba(247, 247, 247, 0.05);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 999px;
    padding: 5px 13px;
  }
  .rr-meta-chip-ok {
    color: #7fd1a8;
    border-color: rgba(79, 180, 119, 0.3);
    background: rgba(79, 180, 119, 0.08);
  }

  /* ── Failures banner (honesty ledger) ── */
  .banner {
    margin: 20px 0 0;
    background: rgba(230, 162, 60, 0.07);
    border: 1px solid rgba(230, 162, 60, 0.25);
    border-left: 3px solid #e6a23c;
    border-radius: 10px;
    padding: 11px 16px;
  }
  .banner summary { cursor: pointer; font-weight: 600; font-size: 13.5px; color: #F7F7F7; }
  .banner summary .banner-icon { margin-right: 6px; color: #e6a23c; }
  .banner summary .banner-hint { font-weight: 400; color: rgba(247, 247, 247, 0.45); font-size: 12px; margin-left: 8px; }
  .banner ul { margin: 12px 0 4px; padding-left: 22px; }
  .banner li {
    margin: 6px 0;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(247, 247, 247, 0.7);
  }
  .banner li .failure-error { color: rgba(247, 247, 247, 0.45); }

  /* ── Stat strip + attribution bar ── */
  .rr-kpis { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0; }
  .rr-kpi { padding: 0 18px; border-right: 1px solid rgba(247, 247, 247, 0.07); }
  .rr-kpi:first-child { padding-left: 0; }
  .rr-kpi:last-child { border-right: none; padding-right: 0; }
  .rr-kpi-label { font-size: 11.5px; font-weight: 500; color: rgba(247, 247, 247, 0.42); }
  .rr-kpi-num {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #F7F7F7;
    line-height: 1;
    margin-top: 9px;
  }
  .rr-kpi-denom { font-size: 15px; font-weight: 500; color: rgba(247, 247, 247, 0.35); margin-left: 2px; }
  .rr-kpi-sub { font-size: 11.5px; color: rgba(247, 247, 247, 0.34); margin-top: 7px; }
  .rr-kpi-sub-ok { color: #7fd1a8; }
  .rr-kpi-sub-bad { color: #f08a8e; }

  .rr-attr-bar {
    display: flex;
    gap: 2px;
    height: 8px;
    margin-top: 20px;
    border-radius: 4px;
    overflow: hidden;
  }
  .rr-attr-seg { cursor: pointer; transition: opacity 0.15s; }
  .rr-attr-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 10px; }
  .rr-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: none;
    padding: 2px 0;
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.6);
    cursor: pointer;
    transition: opacity 0.15s, color 0.15s;
  }
  .rr-legend-item:hover { color: #F7F7F7; }
  .rr-legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .rr-legend-count {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(247, 247, 247, 0.4);
  }
  .rr-legend-note { font-size: 11px; color: rgba(247, 247, 247, 0.3); }

  /* ── Cost hero ──
     Its own grid rather than another cell in .rr-kpis: the strip is pinned to
     seven equal columns and money needs the width. */
  /* auto-fit, not a fixed three: a census priced by both sources draws four
     tiles — one per source, untagged, and the account rollup — and a fixed
     track count dropped the fourth onto a row of its own with the dividers
     still pointing at neighbours it no longer had. */
  .rr-cost-hero { display: grid; grid-template-columns: repeat(auto-fit, minmax(196px, 1fr)); gap: 20px 0; }
  .rr-cost-tile { padding: 0 18px; border-right: 1px solid rgba(247, 247, 247, 0.07); }
  .rr-cost-tile:first-child { padding-left: 0; }
  .rr-cost-tile:last-child { border-right: none; padding-right: 0; }
  .rr-cost-label { font-size: 11.5px; font-weight: 500; color: rgba(247, 247, 247, 0.42); }
  .rr-cost-num {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #F7F7F7;
    line-height: 1.1;
    margin-top: 9px;
    overflow-wrap: anywhere;
  }
  .rr-cost-cur { font-size: 14px; font-weight: 500; color: rgba(247, 247, 247, 0.4); margin-left: 5px; }
  .rr-cost-sub { font-size: 11.5px; color: rgba(247, 247, 247, 0.34); margin-top: 7px; }
  .rr-cost-sub-bad { color: #f08a8e; }
  .rr-cost-note {
    margin-top: 18px;
    max-width: 76ch;
    font-size: 11.5px;
    line-height: 1.6;
    color: rgba(247, 247, 247, 0.4);
  }
  .rr-cost-note p { margin: 0 0 7px; }
  .rr-cost-note p:last-child { margin-bottom: 0; }
  /* The standing explanation of what the two sources are lives behind this,
     because it is the same paragraph on every report ever generated. What
     stays on the page unprompted is only what is true of this census. */
  .rr-cost-more { margin-top: 12px; }
  .rr-cost-more summary {
    cursor: pointer;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.42);
  }
  .rr-cost-more summary:hover { color: rgba(247, 247, 247, 0.7); }
  .rr-cost-more .rr-cost-note { margin-top: 10px; }

  /* ── Cost coverage ──
     One track per source rather than one track split between them. A shared
     bar would make the two sources read as parts of a single whole, which is
     exactly the sum this report refuses to publish: Cost Explorer reports what
     was billed over a closed fortnight and Cost Optimization Hub a modelled
     monthly rate, so each is its own denominator. Identity comes from the row
     label, never from hue alone — the fill carries "priced" and nothing else,
     which is also why both rows share one colour instead of being told apart
     by two that collapse into each other for a deuteranope. */
  .rr-cov { margin-top: 22px; display: flex; flex-direction: column; gap: 13px; }
  .rr-cov-head { font-size: 11.5px; font-weight: 500; color: rgba(247, 247, 247, 0.42); }
  .rr-cov-row {
    display: grid;
    grid-template-columns: minmax(140px, 210px) 1fr auto;
    align-items: center;
    gap: 16px;
  }
  .rr-cov-name { font-size: 12.5px; font-weight: 500; color: rgba(247, 247, 247, 0.78); }
  .rr-cov-basis { font-size: 11px; color: rgba(247, 247, 247, 0.34); margin-top: 2px; }
  .rr-cov-track {
    height: 8px;
    border-radius: 4px;
    background: rgba(247, 247, 247, 0.07);
    overflow: hidden;
  }
  .rr-cov-fill { height: 100%; border-radius: 4px; background: #8ab8fa; }
  .rr-cov-count {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.6);
    white-space: nowrap;
  }
  .rr-cov-none { font-size: 11.5px; color: rgba(247, 247, 247, 0.38); }

  .rr-method { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 20px; }
  .rr-method-label { font-size: 11.5px; color: rgba(247, 247, 247, 0.42); }
  .rr-method-btn {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.55);
    background: rgba(247, 247, 247, 0.05);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 999px;
    padding: 4px 12px;
    cursor: pointer;
  }
  .rr-method-btn:hover { color: #F7F7F7; }
  .rr-method-btn[aria-pressed="true"] {
    color: #F7F7F7;
    border-color: rgba(247, 247, 247, 0.35);
    background: rgba(247, 247, 247, 0.12);
  }

  .rr-recon { margin-top: 20px; }
  /* Standing alone in its own section, the panel already has the section's padding. */
  #cost-audit-section .rr-recon { margin-top: 0; }
  .rr-recon summary { cursor: pointer; font-size: 12px; color: rgba(247, 247, 247, 0.45); }
  .rr-recon summary:hover { color: #F7F7F7; }
  .rr-recon dl { margin: 10px 0 0; }
  .rr-recon dt { font-size: 11.5px; font-weight: 600; color: rgba(247, 247, 247, 0.55); margin-top: 13px; }
  .rr-recon dd {
    margin: 4px 0 0;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    line-height: 1.65;
    color: rgba(247, 247, 247, 0.42);
    overflow-wrap: anywhere;
  }

  /* ── Section ── */
  .rr-section { padding: 24px 0; border-bottom: 1px solid rgba(247, 247, 247, 0.07); }
  .rr-section:last-child { border-bottom: none; padding-bottom: 0; }
  .rr-section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .rr-section-title { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: #F7F7F7; margin: 0; }
  .rr-section-sub { font-size: 12px; color: rgba(247, 247, 247, 0.38); }

  /* shared bar */
  .rr-bar-wrap { height: 6px; background: rgba(247, 247, 247, 0.06); border-radius: 3px; overflow: hidden; }
  .rr-bar { height: 100%; background: rgba(247, 247, 247, 0.3); border-radius: 3px; }

  /* ── Engines rows ── */
  .rr-eng-table { display: flex; flex-direction: column; }
  .rr-eng-row {
    display: grid;
    grid-template-columns: 210px 1fr 120px 48px 90px;
    align-items: center;
    gap: 16px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(247, 247, 247, 0.05);
  }
  .rr-eng-row:last-child { border-bottom: none; }
  .rr-eng-entity { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .rr-eng-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
  .rr-eng-name {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.82);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rr-eng-family { font-size: 11px; color: rgba(247, 247, 247, 0.34); }
  .rr-eng-total {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.75);
    text-align: right;
  }
  .rr-eng-regions {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.38);
    text-align: right;
  }

  /* ── Spend rows ──
     An engine row that clicks. Must follow .rr-eng-row: same specificity, so
     source order is what widens the amount column and strips the button chrome. */
  .rr-spend-row {
    grid-template-columns: 210px 1fr 120px 150px 90px;
    width: 100%;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    border-bottom: 1px solid rgba(247, 247, 247, 0.05);
    cursor: pointer;
  }
  .rr-spend-row:last-child { border-bottom: none; }
  .rr-spend-row:hover { background: rgba(247, 247, 247, 0.03); }
  .rr-spend-row:focus-visible { outline: 1px solid rgba(247, 247, 247, 0.35); outline-offset: -1px; }
  .rr-spend-row[aria-pressed="true"] { background: rgba(247, 247, 247, 0.06); }
  .rr-spend-amount {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.85);
    text-align: right;
    overflow-wrap: anywhere;
  }
  .rr-spend-amount.dim { font-weight: 400; color: rgba(247, 247, 247, 0.3); }

  /* ── Inventory controls + table ── */
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 12px; }
  .controls input[type="search"] {
    flex: 1 1 240px;
    max-width: 420px;
    padding: 8px 14px;
    font: inherit;
    font-size: 13px;
    color: #F7F7F7;
    background: rgba(247, 247, 247, 0.05);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 8px;
  }
  .controls input[type="search"]::placeholder { color: rgba(247, 247, 247, 0.35); }
  .controls label {
    color: rgba(247, 247, 247, 0.45);
    font-size: 12.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .controls select {
    padding: 8px 10px;
    font: inherit;
    font-size: 12.5px;
    color: #F7F7F7;
    background: rgba(247, 247, 247, 0.05);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 8px;
  }
  .controls input[type="search"]:focus,
  .controls select:focus,
  .th-btn:focus-visible,
  .rr-legend-item:focus-visible {
    outline: 2px solid rgba(247, 247, 247, 0.6);
    outline-offset: 1px;
  }

  .table-wrap {
    background: rgba(247, 247, 247, 0.02);
    border: 1px solid rgba(247, 247, 247, 0.08);
    border-radius: 10px;
    overflow: auto;
    max-height: 72vh;
  }
  /* The table body is virtualized, so the scroll container is the wrap rather
     than the page: the script needs one element whose scrollTop maps to a row
     offset. border-spacing over border-collapse because collapsed borders
     vanish under a sticky header. */
  table { width: 100%; border-collapse: separate; border-spacing: 0; }
  thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    text-align: left;
    padding: 0;
    background: #101010;
    border-bottom: 1px solid rgba(247, 247, 247, 0.1);
    white-space: nowrap;
  }
  .th-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    padding: 9px 10px;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(247, 247, 247, 0.45);
    cursor: pointer;
  }
  thead th.num .th-btn { justify-content: flex-end; text-align: right; }
  .th-btn:hover { color: #F7F7F7; }
  .th-btn .dir { font-size: 9px; color: #F7F7F7; min-width: 10px; }
  .th-lab { display: block; }
  /* Window and metric belong in the header, not in a footnote a sorter never
     scrolls to: the column means nothing without them. */
  .th-sub {
    display: block;
    margin-top: 2px;
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    color: rgba(247, 247, 247, 0.32);
  }
  .cost-flag { margin-left: 3px; font-size: 11px; color: rgba(247, 247, 247, 0.45); }
  tbody td {
    padding: 6px 9px;
    border-bottom: 1px solid rgba(247, 247, 247, 0.05);
    font-size: 13px;
    color: rgba(247, 247, 247, 0.75);
    white-space: nowrap;
  }
  /* Sub-labels sit inline, not on a second line. Virtualization positions rows
     by arithmetic, which needs every data row to be the same height; letting
     one cell wrap to two lines would put every row below it in the wrong
     place. Cells are nowrap and .table-wrap scrolls horizontally, so nothing
     is hidden by the change — the row just gets wider. */
  tbody td .sub { margin-left: 6px; }
  tbody tr:hover td { background: rgba(247, 247, 247, 0.03); }
  tbody tr.group-row td {
    background: rgba(247, 247, 247, 0.045);
    font-weight: 600;
    font-size: 12px;
    color: #F7F7F7;
    padding: 0;
  }
  tbody tr.group-row:hover td { background: rgba(247, 247, 247, 0.06); }
  .group-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 10px;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    color: #F7F7F7;
    text-align: left;
    cursor: pointer;
  }
  .group-caret {
    display: inline-block;
    width: 9px;
    font-size: 9px;
    color: rgba(247, 247, 247, 0.45);
  }
  .group-count { color: rgba(247, 247, 247, 0.45); font-weight: 400; }
  .group-cost { margin-left: auto; font-weight: 500; font-variant-numeric: tabular-nums; }
  .group-cost .sub { margin-left: 5px; }
  /* The covered fraction rides with the total rather than under it: the two are
     one statement, and a total that outruns its qualifier for even a line has
     already been read as the whole group's. */
  .group-partial {
    margin-left: 6px;
    color: rgba(247, 247, 247, 0.45);
    font-weight: 400;
    font-size: 11px;
  }
  /* Spacer rows stand in for the rows scrolled out of view. They must
     contribute their exact height and nothing else. */
  tbody tr.spacer td { padding: 0; border: none; background: none; }
  tbody tr.spacer:hover td { background: none; }
  td.mono, .mono {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }
  td.mono { color: rgba(247, 247, 247, 0.8); }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .sub { color: rgba(247, 247, 247, 0.4); font-size: 11px; }
  .dim { color: rgba(247, 247, 247, 0.3); }
  tr.no-match td { padding: 20px 12px; text-align: center; }
  .tier-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: 0;
  }

  /* ── Value tags (environment, status) ── */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid rgba(247, 247, 247, 0.12);
    background: rgba(247, 247, 247, 0.05);
    color: rgba(247, 247, 247, 0.65);
    white-space: nowrap;
  }
  .tag-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .tag-green  { color: #7fd1a8; border-color: rgba(79, 180, 119, 0.3);  background: rgba(79, 180, 119, 0.08); }
  .tag-amber  { color: #eab765; border-color: rgba(230, 162, 60, 0.3);  background: rgba(230, 162, 60, 0.08); }
  .tag-red    { color: #f08a8e; border-color: rgba(229, 72, 77, 0.35);  background: rgba(229, 72, 77, 0.09); }
  .tag-blue   { color: #8ab8fa; border-color: rgba(90, 156, 248, 0.3);  background: rgba(90, 156, 248, 0.08); }
  .tag-purple { color: #ac9ff8; border-color: rgba(139, 124, 246, 0.3); background: rgba(139, 124, 246, 0.08); }
  .tag-cyan   { color: #7cd0f8; border-color: rgba(56, 189, 248, 0.3);  background: rgba(56, 189, 248, 0.08); }
  .tag-pink   { color: #f7a1cb; border-color: rgba(244, 114, 182, 0.3); background: rgba(244, 114, 182, 0.08); }

  /* ── Empty state ── */
  .empty h2 { margin: 0 0 8px; font-size: 17px; color: #F7F7F7; }
  .empty p { margin: 0 0 8px; color: rgba(247, 247, 247, 0.55); }
  .empty ul { margin: 0; padding-left: 22px; color: rgba(247, 247, 247, 0.55); }
  .empty li { margin: 4px 0; }
  .empty .mono { color: rgba(247, 247, 247, 0.75); font-size: 12.5px; }

  /* ── Footer ── */
  .rr-foot {
    margin-top: 28px;
    text-align: center;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.3);
  }
  .rr-foot a { color: rgba(247, 247, 247, 0.5); text-decoration: none; }
  .rr-foot a:hover { text-decoration: underline; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .rr-kpis { grid-template-columns: repeat(3, 1fr); gap: 18px 24px; }
    .rr-kpi { border-right: none; padding: 0; }
    .rr-cost-hero { grid-template-columns: 1fr 1fr; gap: 20px 26px; }
    .rr-cost-tile { border-right: none; padding: 0; }
  }
  @media (max-width: 680px) {
    .rr-eng-row, .rr-spend-row { grid-template-columns: 1fr auto; }
    .rr-eng-family, .rr-eng-row .rr-bar-wrap, .rr-eng-regions { display: none; }
  }
  @media (max-width: 600px) {
    .rr-page { padding: 28px 16px 56px; }
    .rr-kpis { grid-template-columns: 1fr; }
    .rr-cost-hero { grid-template-columns: 1fr; }
  }
</style>
</head>
