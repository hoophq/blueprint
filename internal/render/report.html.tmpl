<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<title>blueprint report</title>
<style>
  /* blueprint report — dark, single file, no external resources:
     font-family names only, everything inline.

     Two rules govern this file, both enforced by internal/render/html_test.go,
     and both by scanning the finished page for literal text. That matters when
     writing comments here: the scan cannot tell a note about a forbidden
     construct from the construct itself, so this one describes them without
     spelling any of them out. The list itself lives in html_test.go.

     1. Nothing loads from off the machine. No stylesheet or script may be
        pulled in by reference, in markup or from CSS, and the one href in the
        page points at the project's own repository. Everything the report
        needs is inline, because it is opened from disk, offline, by someone
        who may have no reason to trust an outbound request.

     2. No HTML comments, anywhere. The sequence that opens one — like the one
        that closes a script tag — ends the HTML parser's script-data state,
        and either would let census content escape into markup. The template
        writes its notes as CSS comments (here) and JavaScript comments
        (below) instead. */
  :root { color-scheme: dark; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    min-height: 100vh;
    background: #0c0c0c;
    color: #F7F7F7;
    font-family: Inter, system-ui, -apple-system, sans-serif;
    font-size: 14px;
    line-height: 1.45;
  }
  [hidden] { display: none !important; }

  .rr-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 40px 32px 64px;
  }

  /* ── Header ── */
  .rr-head { padding-bottom: 18px; border-bottom: 1px solid rgba(247, 247, 247, 0.07); }
  .rr-head-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .rr-brand { display: flex; align-items: center; gap: 8px; }
  .rr-brand-name {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 600;
    color: rgba(247, 247, 247, 0.75);
  }
  .rr-brand-ver {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(247, 247, 247, 0.35);
    background: rgba(247, 247, 247, 0.06);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 5px;
    padding: 2px 7px;
  }
  .rr-gen {
    margin-left: auto;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.35);
  }
  .rr-meta-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .rr-meta-chip {
    font-size: 12px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.55);
    background: rgba(247, 247, 247, 0.05);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 999px;
    padding: 5px 13px;
  }
  .rr-meta-chip-ok {
    color: #7fd1a8;
    border-color: rgba(79, 180, 119, 0.3);
    background: rgba(79, 180, 119, 0.08);
  }

  /* ── Failures banner (honesty ledger) ── */
  .banner {
    margin: 20px 0 0;
    background: rgba(230, 162, 60, 0.07);
    border: 1px solid rgba(230, 162, 60, 0.25);
    border-left: 3px solid #e6a23c;
    border-radius: 10px;
    padding: 11px 16px;
  }
  .banner summary { cursor: pointer; font-weight: 600; font-size: 13.5px; color: #F7F7F7; }
  .banner summary .banner-icon { margin-right: 6px; color: #e6a23c; }
  .banner summary .banner-hint { font-weight: 400; color: rgba(247, 247, 247, 0.45); font-size: 12px; margin-left: 8px; }
  .banner ul { margin: 12px 0 4px; padding-left: 22px; }
  .banner li {
    margin: 6px 0;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: rgba(247, 247, 247, 0.7);
  }
  .banner li .failure-error { color: rgba(247, 247, 247, 0.45); }

  /* ── Stat strip + attribution bar ── */
  .rr-kpis { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0; }
  .rr-kpi { padding: 0 18px; border-right: 1px solid rgba(247, 247, 247, 0.07); }
  .rr-kpi:first-child { padding-left: 0; }
  .rr-kpi:last-child { border-right: none; padding-right: 0; }
  .rr-kpi-label { font-size: 11.5px; font-weight: 500; color: rgba(247, 247, 247, 0.42); }
  .rr-kpi-num {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #F7F7F7;
    line-height: 1;
    margin-top: 9px;
  }
  .rr-kpi-denom { font-size: 15px; font-weight: 500; color: rgba(247, 247, 247, 0.35); margin-left: 2px; }
  .rr-kpi-sub { font-size: 11.5px; color: rgba(247, 247, 247, 0.34); margin-top: 7px; }
  .rr-kpi-sub-ok { color: #7fd1a8; }
  .rr-kpi-sub-bad { color: #f08a8e; }

  .rr-attr-bar {
    display: flex;
    gap: 2px;
    height: 8px;
    margin-top: 20px;
    border-radius: 4px;
    overflow: hidden;
  }
  .rr-attr-seg { cursor: pointer; transition: opacity 0.15s; }
  .rr-attr-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 10px; }
  .rr-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: none;
    border: none;
    padding: 2px 0;
    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.6);
    cursor: pointer;
    transition: opacity 0.15s, color 0.15s;
  }
  .rr-legend-item:hover { color: #F7F7F7; }
  .rr-legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .rr-legend-count {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: rgba(247, 247, 247, 0.4);
  }

  /* ── Section ── */
  .rr-section { padding: 24px 0; border-bottom: 1px solid rgba(247, 247, 247, 0.07); }
  .rr-section:last-child { border-bottom: none; padding-bottom: 0; }
  .rr-section-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .rr-section-title { font-size: 16px; font-weight: 700; letter-spacing: -0.01em; color: #F7F7F7; margin: 0; }
  .rr-section-sub { font-size: 12px; color: rgba(247, 247, 247, 0.38); }

  /* shared bar */
  .rr-bar-wrap { height: 6px; background: rgba(247, 247, 247, 0.06); border-radius: 3px; overflow: hidden; }
  .rr-bar { height: 100%; background: rgba(247, 247, 247, 0.3); border-radius: 3px; }

  /* ── Engines rows ── */
  .rr-eng-table { display: flex; flex-direction: column; }
  .rr-eng-row {
    display: grid;
    grid-template-columns: 210px 1fr 120px 48px 90px;
    align-items: center;
    gap: 16px;
    padding: 7px 0;
    border-bottom: 1px solid rgba(247, 247, 247, 0.05);
  }
  .rr-eng-row:last-child { border-bottom: none; }
  .rr-eng-entity { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .rr-eng-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
  .rr-eng-name {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.82);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rr-eng-family { font-size: 11px; color: rgba(247, 247, 247, 0.34); }
  .rr-eng-total {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    font-weight: 500;
    color: rgba(247, 247, 247, 0.75);
    text-align: right;
  }
  .rr-eng-regions {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.38);
    text-align: right;
  }

  /* ── Inventory controls + table ── */
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 12px; }
  .controls input[type="search"] {
    flex: 1 1 240px;
    max-width: 420px;
    padding: 8px 14px;
    font: inherit;
    font-size: 13px;
    color: #F7F7F7;
    background: rgba(247, 247, 247, 0.05);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 8px;
  }
  .controls input[type="search"]::placeholder { color: rgba(247, 247, 247, 0.35); }
  .controls label {
    color: rgba(247, 247, 247, 0.45);
    font-size: 12.5px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .controls select {
    padding: 8px 10px;
    font: inherit;
    font-size: 12.5px;
    color: #F7F7F7;
    background: rgba(247, 247, 247, 0.05);
    border: 1px solid rgba(247, 247, 247, 0.1);
    border-radius: 8px;
  }
  .controls input[type="search"]:focus,
  .controls select:focus,
  .th-btn:focus-visible,
  .rr-legend-item:focus-visible {
    outline: 2px solid rgba(247, 247, 247, 0.6);
    outline-offset: 1px;
  }

  .table-wrap {
    background: rgba(247, 247, 247, 0.02);
    border: 1px solid rgba(247, 247, 247, 0.08);
    border-radius: 10px;
    overflow: auto;
    max-height: 72vh;
  }
  /* The table body is virtualized, so the scroll container is the wrap rather
     than the page: the script needs one element whose scrollTop maps to a row
     offset. border-spacing over border-collapse because collapsed borders
     vanish under a sticky header. */
  table { width: 100%; border-collapse: separate; border-spacing: 0; }
  thead th {
    position: sticky;
    top: 0;
    z-index: 1;
    text-align: left;
    padding: 0;
    background: #101010;
    border-bottom: 1px solid rgba(247, 247, 247, 0.1);
    white-space: nowrap;
  }
  .th-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    width: 100%;
    padding: 9px 10px;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(247, 247, 247, 0.45);
    cursor: pointer;
  }
  thead th.num .th-btn { justify-content: flex-end; }
  .th-btn:hover { color: #F7F7F7; }
  .th-btn .dir { font-size: 9px; color: #F7F7F7; min-width: 10px; }
  tbody td {
    padding: 6px 9px;
    border-bottom: 1px solid rgba(247, 247, 247, 0.05);
    font-size: 13px;
    color: rgba(247, 247, 247, 0.75);
    white-space: nowrap;
  }
  /* Sub-labels sit inline, not on a second line. Virtualization positions rows
     by arithmetic, which needs every data row to be the same height; letting
     one cell wrap to two lines would put every row below it in the wrong
     place. Cells are nowrap and .table-wrap scrolls horizontally, so nothing
     is hidden by the change — the row just gets wider. */
  tbody td .sub { margin-left: 6px; }
  tbody tr:hover td { background: rgba(247, 247, 247, 0.03); }
  tbody tr.group-row td {
    background: rgba(247, 247, 247, 0.045);
    font-weight: 600;
    font-size: 12px;
    color: #F7F7F7;
    padding: 0;
  }
  tbody tr.group-row:hover td { background: rgba(247, 247, 247, 0.06); }
  .group-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 8px 10px;
    background: none;
    border: none;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    color: #F7F7F7;
    text-align: left;
    cursor: pointer;
  }
  .group-caret {
    display: inline-block;
    width: 9px;
    font-size: 9px;
    color: rgba(247, 247, 247, 0.45);
  }
  .group-count { color: rgba(247, 247, 247, 0.45); font-weight: 400; }
  .group-cost { margin-left: auto; font-weight: 500; font-variant-numeric: tabular-nums; }
  .group-cost .sub { margin-left: 5px; }
  /* The covered fraction rides with the total rather than under it: the two are
     one statement, and a total that outruns its qualifier for even a line has
     already been read as the whole group's. */
  .group-partial {
    margin-left: 6px;
    color: rgba(247, 247, 247, 0.45);
    font-weight: 400;
    font-size: 11px;
  }
  /* Spacer rows stand in for the rows scrolled out of view. They must
     contribute their exact height and nothing else. */
  tbody tr.spacer td { padding: 0; border: none; background: none; }
  tbody tr.spacer:hover td { background: none; }
  td.mono, .mono {
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
  }
  td.mono { color: rgba(247, 247, 247, 0.8); }
  td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .sub { color: rgba(247, 247, 247, 0.4); font-size: 11px; }
  .dim { color: rgba(247, 247, 247, 0.3); }
  tr.no-match td { padding: 20px 12px; text-align: center; }
  .tier-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    margin-right: 8px;
    vertical-align: 0;
  }

  /* ── Value tags (environment, status) ── */
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid rgba(247, 247, 247, 0.12);
    background: rgba(247, 247, 247, 0.05);
    color: rgba(247, 247, 247, 0.65);
    white-space: nowrap;
  }
  .tag-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
  .tag-green  { color: #7fd1a8; border-color: rgba(79, 180, 119, 0.3);  background: rgba(79, 180, 119, 0.08); }
  .tag-amber  { color: #eab765; border-color: rgba(230, 162, 60, 0.3);  background: rgba(230, 162, 60, 0.08); }
  .tag-red    { color: #f08a8e; border-color: rgba(229, 72, 77, 0.35);  background: rgba(229, 72, 77, 0.09); }
  .tag-blue   { color: #8ab8fa; border-color: rgba(90, 156, 248, 0.3);  background: rgba(90, 156, 248, 0.08); }
  .tag-purple { color: #ac9ff8; border-color: rgba(139, 124, 246, 0.3); background: rgba(139, 124, 246, 0.08); }
  .tag-cyan   { color: #7cd0f8; border-color: rgba(56, 189, 248, 0.3);  background: rgba(56, 189, 248, 0.08); }
  .tag-pink   { color: #f7a1cb; border-color: rgba(244, 114, 182, 0.3); background: rgba(244, 114, 182, 0.08); }

  /* ── Empty state ── */
  .empty h2 { margin: 0 0 8px; font-size: 17px; color: #F7F7F7; }
  .empty p { margin: 0 0 8px; color: rgba(247, 247, 247, 0.55); }
  .empty ul { margin: 0; padding-left: 22px; color: rgba(247, 247, 247, 0.55); }
  .empty li { margin: 4px 0; }
  .empty .mono { color: rgba(247, 247, 247, 0.75); font-size: 12.5px; }

  /* ── Footer ── */
  .rr-foot {
    margin-top: 28px;
    text-align: center;
    font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    color: rgba(247, 247, 247, 0.3);
  }
  .rr-foot a { color: rgba(247, 247, 247, 0.5); text-decoration: none; }
  .rr-foot a:hover { text-decoration: underline; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .rr-kpis { grid-template-columns: repeat(3, 1fr); gap: 18px 24px; }
    .rr-kpi { border-right: none; padding: 0; }
  }
  @media (max-width: 680px) {
    .rr-eng-row { grid-template-columns: 1fr auto; }
    .rr-eng-family, .rr-eng-row .rr-bar-wrap, .rr-eng-regions { display: none; }
  }
  @media (max-width: 600px) {
    .rr-page { padding: 28px 16px 56px; }
    .rr-kpis { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="rr-page">

  <header class="rr-head">
    <div class="rr-head-row">
      <div class="rr-brand">
        <svg width="18" height="18" viewBox="0 0 148 148" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M96.4167 71.4077C99.0238 71.5517 101.631 71.7389 104.238 71.9118L106.6 72.0558C114.055 73.1865 121.677 71.9359 128.38 68.4821C135.083 65.0282 140.525 59.5473 143.931 52.82C147.337 46.0928 148.533 38.4622 147.349 31.0153C146.166 23.5685 142.662 16.685 137.338 11.3455C132.014 6.00604 125.14 2.48279 117.697 1.27765C110.254 0.0725119 102.62 1.24695 95.8826 4.63367C89.1456 8.02038 83.6491 13.4467 80.176 20.1396C76.7029 26.8325 75.4304 34.4507 76.5397 41.909C76.5397 42.73 76.6405 43.551 76.6982 44.372C76.871 46.9791 77.0582 49.6005 77.1879 52.2076C77.5862 56.2358 77.0945 60.3023 75.7475 64.1194C74.7082 66.7342 73.1556 69.1144 71.1816 71.1196C69.1658 73.1255 66.7584 74.6945 64.1094 75.7287C60.2922 77.0757 56.2257 77.5675 52.1976 77.1691C49.5905 77.0395 46.9691 76.8522 44.362 76.6794L41.899 76.5209C34.4419 75.414 26.8257 76.688 20.1348 80.1613C13.4439 83.6347 8.01933 89.1305 4.63351 95.8662C1.24769 102.602 0.0732001 110.234 1.27728 117.676C2.48136 125.118 6.00262 131.99 11.3397 137.315C16.6768 142.639 23.5576 146.144 31.0024 147.33C38.4472 148.516 46.0766 147.324 52.8041 143.922C59.5317 140.52 65.0144 135.082 68.4718 128.383C71.9292 121.684 73.1849 114.065 72.0602 106.61C72.0602 105.818 71.9738 105.04 71.9162 104.248C71.7433 101.641 71.5561 99.0338 71.412 96.4268C71.0353 92.3933 71.5517 88.3263 72.9244 84.515C73.9445 81.8936 75.4939 79.5106 77.476 77.5148C79.4819 75.5453 81.8621 73.9976 84.4761 72.9633C88.2932 71.5717 92.3705 71.0405 96.4167 71.4077Z" fill="#F7F7F7"/>
          <path d="M36.7283 63.0103C51.238 63.0103 63.0005 51.2478 63.0005 36.7381C63.0005 22.2283 51.238 10.4658 36.7283 10.4658C22.2185 10.4658 10.4561 22.2283 10.4561 36.7381C10.4561 51.2478 22.2185 63.0103 36.7283 63.0103Z" fill="#F7F7F7"/>
          <path d="M111.944 138.226C126.454 138.226 138.216 126.464 138.216 111.954C138.216 97.4441 126.454 85.6816 111.944 85.6816C97.4344 85.6816 85.6719 97.4441 85.6719 111.954C85.6719 126.464 97.4344 138.226 111.944 138.226Z" fill="#F7F7F7"/>
        </svg>
        <span class="rr-brand-name">blueprint</span>
        <span class="rr-brand-ver" id="brand-ver"></span>
      </div>
      <span class="rr-gen">generated locally &middot; <span id="gen-at"></span></span>
    </div>
    <div class="rr-meta-row">
      <span class="rr-meta-chip" id="chip-scope"></span>
      <span class="rr-meta-chip">read-only</span>
      <span class="rr-meta-chip rr-meta-chip-ok">computed locally &middot; nothing leaves your machine</span>
    </div>
  </header>

  <section id="failures-banner" class="banner" hidden>
    <details>
      <summary><span class="banner-icon">&#9888;</span><span id="failures-title"></span><span class="banner-hint">expand for details</span></summary>
      <ul id="failures-list"></ul>
    </details>
  </section>

  <section id="empty-state" class="rr-section empty" hidden>
    <h2>No resources found</h2>
    <p>The scan completed but discovered nothing. Possible causes:</p>
    <ul>
      <li>The credentials point at the wrong AWS account or profile.</li>
      <li>The scanned regions host none of the services blueprint covers &mdash; try scanning more regions.</li>
      <li>The role is missing read permissions (for example <span class="mono">rds:DescribeDBInstances</span>, <span class="mono">dynamodb:ListTables</span>, <span class="mono">elasticache:DescribeCacheClusters</span>).</li>
      <li>The workloads are self-hosted on EC2 &mdash; blueprint only sees AWS-managed services.</li>
    </ul>
  </section>

  <section class="rr-section" id="stats-section">
    <div class="rr-kpis" id="kpis"></div>
    <div class="rr-attr-bar" id="attr-bar" aria-label="Resources by attribution tier"></div>
    <div class="rr-attr-legend" id="attr-legend"></div>
  </section>

  <section class="rr-section" id="engines-section">
    <div class="rr-section-head">
      <h2 class="rr-section-title">Platforms</h2>
      <span class="rr-section-sub" id="engines-sub"></span>
    </div>
    <div class="rr-eng-table" id="engine-rows"></div>
  </section>

  <section class="rr-section" id="table-section">
    <div class="rr-section-head">
      <h2 class="rr-section-title">Inventory</h2>
      <span class="rr-section-sub" id="row-count"></span>
    </div>
    <div class="controls">
      <input id="filter" type="search" placeholder="Filter by name, type, engine, ARN, or tag" aria-label="Filter resources">
      <label>Group by
        <select id="groupby">
          <option value="none" selected>none</option>
          <option value="service">service</option>
          <option value="type">type</option>
          <option value="engine">platform</option>
          <option value="environment">environment</option>
          <option value="region">region</option>
          <option value="account">account</option>
        </select>
      </label>
    </div>
    <div class="table-wrap" id="table-wrap">
      <table id="census">
        <thead><tr id="head-row"></tr></thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </section>

  <section id="decode-error" class="rr-section empty" hidden>
    <h2>This browser cannot open the inventory</h2>
    <p id="decode-error-msg"></p>
  </section>

  <footer class="rr-foot">generated locally by blueprint &mdash; open source: <a href="https://github.com/hoophq/blueprint" target="_blank" rel="noreferrer">github.com/hoophq/blueprint</a> &middot; nothing leaves your machine</footer>

</div>

<script type="application/json" id="blueprint-meta">__BLUEPRINT_META__</script>
<script type="application/json" id="blueprint-data">__BLUEPRINT_DATA__</script>
<script>
(function () {
  "use strict";

  // The page arrives in two blocks.
  //
  // The meta block is small and always plain JSON: scan metadata, the failure
  // ledger, the cost rollups, and a summary Go already folded over the whole
  // census. Everything above the inventory table is painted from it, straight
  // away, without the browser looking at a single resource.
  //
  // The census block is the resources, transposed into columns and — past a
  // few thousand of them — gzipped and base64'd, because a census that would
  // be twenty megabytes of row JSON is a few hundred kilobytes this way.
  // Unpacking it needs DecompressionStream, so it is asynchronous and it can
  // fail on an old browser; that is why nothing above the table depends on it.
  var WIRE = 1;
  var ENCODING_JSON = "json";
  var ENCODING_GZIP = "gzip+base64";
  var meta = JSON.parse(document.getElementById("blueprint-meta").textContent);
  var summary = meta.summary || {};
  var failures = meta.failures || [];
  var total = summary.total || 0;

  // resources stays null until the census block is decoded. Every table
  // function checks it, so a click that lands during the decode does nothing
  // instead of throwing.
  var resources = null;

  // Attribution tiers: ownership hygiene computed from owner/environment tags.
  // Ordered as they appear in the stacked attribution bar and its legend.
  var TIERS = [
    { key: "full", label: "Fully attributed", color: "#4fb477", count: summary.full || 0 },
    { key: "partial", label: "Partially attributed", color: "#e6a23c", count: summary.partial || 0 },
    { key: "untagged", label: "Untagged", color: "#e5484d", count: summary.untagged || 0 }
  ];
  var TIER_BY_KEY = {};
  TIERS.forEach(function (t) { TIER_BY_KEY[t.key] = t; });

  // Service colors are derived from the name rather than looked up in a table.
  // A fixed palette covered the seven services this report started with; a
  // total census reaches dozens, so most rows fell through to one grey and
  // every new service arrived unpainted. Hashing the name gives every service
  // a color, the same color in every report and every scan, with nothing to
  // maintain. Saturation and lightness are fixed so all of them stay legible
  // on the near-black page. A resource with no service name keeps the neutral
  // grey rather than being assigned a color that would look meaningful.
  var SERVICE_FALLBACK = "rgba(247,247,247,0.35)";
  function hashColor(name) {
    if (!name) return SERVICE_FALLBACK;
    var h = 0;
    for (var i = 0; i < name.length; i++) h = (h * 31 + name.charCodeAt(i)) >>> 0;
    return "hsl(" + (h % 360) + ", 62%, 62%)";
  }

  function tierOf(r) {
    if (r.owner && r.environment) return "full";
    if (r.owner || r.environment) return "partial";
    return "untagged";
  }

  // Service-specific detail lives in the attribute bag rather than in fixed
  // columns, so the report keeps working as new services land. An absent key
  // means the service did not report it — never a zero or an empty string.
  function attr(r, key) {
    return (r.attributes && r.attributes[key]) || "";
  }
  // measure returns the numeric value or undefined when not reported, so a
  // real zero (no backups, empty table) never reads the same as silence.
  function measure(r, key) {
    return r.measures ? r.measures[key] : undefined;
  }

  // The "Class" column shows whichever sizing dimension a service actually
  // bills on. Presentation only — the data keeps each concept under its own
  // key, so the unit is attached here rather than stored pre-formatted.
  // CLASS_MEASURES covers services sized by a number instead of a named class
  // (Redshift Serverless bills in RPUs), which would otherwise leave the
  // column empty for a capacity the service did report.
  var CLASS_KEYS = ["instance_class", "billing_mode"];
  var CLASS_MEASURES = [{ key: "base_capacity_rpu", unit: "RPU" }];

  // PLATFORM_KEYS names the software a resource runs, which each service calls
  // something different: RDS reports "engine", Lambda reports "runtime". Both
  // feed the same column and the same end-of-life badge, so both are read here
  // rather than only the first one this report happened to support.
  //
  // A runtime identifier carries its own version ("python3.8"), so those rows
  // have no engine_version beside them and the sub-label is simply absent.
  var PLATFORM_KEYS = ["engine", "runtime"];

  function platformOf(r) {
    for (var i = 0; i < PLATFORM_KEYS.length; i++) {
      var a = attr(r, PLATFORM_KEYS[i]);
      if (a) return a;
    }
    return "";
  }

  function classOf(r) {
    for (var i = 0; i < CLASS_KEYS.length; i++) {
      var a = attr(r, CLASS_KEYS[i]);
      if (a) return a;
    }
    for (var j = 0; j < CLASS_MEASURES.length; j++) {
      var m = measure(r, CLASS_MEASURES[j].key);
      if (typeof m === "number") return m + " " + CLASS_MEASURES[j].unit;
    }
    return "";
  }

  // Exposure flags are tri-state in the data: absent means the service does
  // not report the field, so only explicit risky values count.
  function isExposed(r) {
    return r.publicly_accessible === true || r.encrypted === false || r._backup === 0;
  }

  // ---- Census block ---------------------------------------------------------
  //
  // The resources arrive transposed: one array per field rather than one object
  // per resource, with each column's repeated strings pulled into a dictionary
  // and referenced by index. A census is mostly the same values over and over —
  // the same dozen regions, the same handful of instance classes, the same
  // "arn:aws:ec2" fifty thousand times — so storing each once and pointing at
  // it is where most of the saving comes from, before compression even runs.
  //
  // readTable puts the rows back together. Everything downstream sees the same
  // row objects, bags and all, that the report has always used, so nothing else
  // on the page knows the wire format exists.

  // decodeCensus unpacks the census block.
  //
  // Below a few thousand resources the block is plain JSON and this is a parse.
  // Above that it is gzip, base64'd so it can sit inside the page, and unpacked
  // with DecompressionStream — a browser built-in, because this report loads
  // nothing and ships no libraries. That makes the decode asynchronous, and on
  // a browser older than about 2023 it makes it impossible. Both are why
  // nothing above the table waits for it.
  function decodeCensus() {
    if (meta.wire !== WIRE) {
      return Promise.reject(new Error(
        "This file was written by a different version of blueprint: its inventory is in " +
        "payload format " + meta.wire + " and this page reads format " + WIRE + "."));
    }
    if (meta.encoding !== ENCODING_JSON && meta.encoding !== ENCODING_GZIP) {
      return Promise.reject(new Error("This report's inventory is in an encoding this page does not know: " + meta.encoding + "."));
    }
    if (meta.encoding === ENCODING_GZIP && typeof DecompressionStream !== "function") {
      return Promise.reject(new Error(
        "The inventory in this report is compressed, and this browser has no built-in way " +
        "to decompress it. Chrome or Edge 80+, Firefox 113+, or Safari 16.4+ will open it. " +
        "The same census is in the JSON and CSV files written alongside this one, which " +
        "need no browser at all."));
    }
    // Everything above rejects; everything below can throw. JSON.parse and atob
    // run synchronously, so on a truncated or hand-edited file they raise before
    // any promise exists and sail straight past the .catch that puts the reason
    // on screen — leaving disabled controls, a "reading…" label, and no
    // explanation. Both paths are funnelled back into a rejection here.
    var raw = document.getElementById("blueprint-data").textContent;
    try {
      if (meta.encoding === ENCODING_JSON) return Promise.resolve(JSON.parse(raw));
      return inflate(raw).catch(function (err) { throw unreadable(err); });
    } catch (err) {
      return Promise.reject(unreadable(err));
    }
  }

  function inflate(raw) {
    var bin = atob(raw);
    var bytes = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    var stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream("gzip"));
    return new Response(stream).text().then(JSON.parse);
  }

  // unreadable turns a decoder's own words — "Unexpected token }", "incorrect
  // header check" — into something that tells the reader what happened and
  // where the same census still is, without hiding the original.
  function unreadable(err) {
    return new Error(
      "The inventory in this report could not be read; the file looks truncated or edited. " +
      "The same census is in the JSON and CSV files written alongside it. (" +
      ((err && err.message) || String(err)) + ")");
  }

  // failCensus replaces the table with the reason there isn't one. Everything
  // above it — the scan metadata, the failure ledger, the headline counts —
  // came from the meta block and stays on screen, so the reader still learns
  // what was scanned and what it found.
  function failCensus(err) {
    document.getElementById("table-section").hidden = true;
    document.getElementById("decode-error-msg").textContent = (err && err.message) || String(err);
    document.getElementById("decode-error").hidden = false;
  }

  var COL_TAG = "tag:";
  var COL_ATTR = "attr:";

  // targetOf works out where a column lands on the rebuilt row — once per
  // column, not once per cell.
  function targetOf(key) {
    if (key.indexOf(COL_TAG) === 0) return { bag: "tags", name: key.slice(COL_TAG.length) };
    if (key.indexOf(COL_ATTR) === 0) return { bag: "attributes", name: key.slice(COL_ATTR.length) };
    return { bag: null, name: key };
  }

  function readTable(t) {
    var n = t.n || 0;
    var i;
    var rows = new Array(n);
    // The bags are keyed by strings AWS chose, and "__proto__" is a legal tag
    // key. Assigning it on an ordinary object hits the prototype setter and is
    // silently swallowed — the tag would vanish between the encoder and the
    // page, which is the one thing this report may not do. A null prototype
    // makes every key an ordinary own property, and matches what JSON.parse
    // already does on the uncompressed path.
    for (i = 0; i < n; i++) {
      rows[i] = { tags: Object.create(null), attributes: Object.create(null), measures: Object.create(null) };
    }

    var str = t.str || {};
    Object.keys(str).forEach(function (key) {
      var col = str[key] || {};
      var dict = col.d || [];
      var idx = col.i || [];
      var to = targetOf(key);
      for (var j = 0; j < n; j++) {
        // A negative index is "the service did not report this field". The row
        // gets no key at all, which is what every reader downstream already
        // treats as absence.
        var k = idx[j];
        if (!(k >= 0)) continue;
        if (to.bag) rows[j][to.bag][to.name] = dict[k];
        else rows[j][to.name] = dict[k];
      }
    });

    // Measures are the only numbers on the wire, so they carry no prefix. null
    // is absence; 0 is a reading — a zero-byte table, a zero-day backup window
    // — and it is kept like any other number. Testing these for truthiness
    // instead of for null is the one bug this encoding exists to not have.
    var num = t.num || {};
    Object.keys(num).forEach(function (key) {
      var col = num[key] || [];
      for (var j = 0; j < n; j++) {
        var v = col[j];
        if (v === null || v === undefined) continue;
        rows[j].measures[key] = v;
      }
    });

    // Exposure flags are tri-state: true, false, or a service with no such
    // concept. The third stays undefined on the row, which is why the
    // renderers test === true and === false rather than truthiness.
    var bool = t.bool || {};
    Object.keys(bool).forEach(function (key) {
      var col = bool[key] || [];
      for (var j = 0; j < n; j++) {
        var v = col[j];
        if (v === null || v === undefined) continue;
        rows[j][key] = v;
      }
    });

    if (t.costs) {
      for (i = 0; i < n; i++) {
        if (t.costs[i]) rows[i].costs = t.costs[i];
      }
    }

    // Most ARNs were never stored. They are rebuilt from the head, the
    // resource-part prefix, and the region, account and name the row already
    // carries — the same three lines as decodeARN in payload.go, and Go checked
    // the reassembly against the real ARN before dropping anything. An ARN that
    // did not survive that round trip was stored verbatim instead, so a row has
    // one representation or the other and never both.
    for (i = 0; i < n; i++) {
      var r = rows[i];
      if (r.arn_head === undefined) continue;
      r.arn = r.arn_head + ":" + (r.region || "") + ":" + (r.account_id || "") + ":" +
        (r.arn_infix || "") + (r.name || "");
      delete r.arn_head;
      delete r.arn_infix;
    }
    return rows;
  }

  // Precompute the tier and the bag lookups every renderer needs, so the rest
  // of the report reads plain fields. One pass, and the only one before first
  // paint — the headline numbers are already folded in the meta block.
  function precompute() {
    for (var i = 0; i < resources.length; i++) {
      var r = resources[i];
      r._tier = tierOf(r);
      r._engine = platformOf(r);
      r._engineVersion = attr(r, "engine_version");
      r._class = classOf(r);
      r._sizeBytes = measure(r, "size_bytes");
      r._sizeAsOf = attr(r, "size_bytes_as_of");
      r._backup = measure(r, "backup_retention_days");
      // "AWS::RDS::DBCluster" → "DBCluster": the CloudFormation type without
      // the provider/service prefix already shown in the Service column.
      r._typeShort = String(r.type || "").split("::").pop();
    }
  }

  // The filter's haystack is built on demand and kept.
  //
  // It is the largest derived thing in the page — every searchable string of
  // every resource, concatenated — and a census that is never filtered never
  // needs it. Building it eagerly put tens of megabytes of string between the
  // reader and first paint for a search box they may not touch. Building it on
  // the first keystroke moves that cost to the moment it buys something, and
  // caching it on the row keeps every keystroke after the first cheap.
  function hayOf(r) {
    if (r._hay !== undefined) return r._hay;
    var hay = [r.name, r._engine, r._engineVersion, r.arn, r.service, r.type,
      r.region, r.account_id, r.environment, r.owner, r.status, r._class];
    if (r.eol) hay.push("eol");
    if (isExposed(r)) hay.push("exposed");
    if (r.publicly_accessible === true) hay.push("public");
    if (r.encrypted === false) hay.push("unencrypted");
    if (r._backup === 0) hay.push("no-backups");
    if (r.tags) {
      Object.keys(r.tags).forEach(function (k) {
        hay.push(k, r.tags[k], k + "=" + r.tags[k]);
      });
    }
    r._hay = hay.filter(Boolean).join("\n").toLowerCase();
    return r._hay;
  }

  // formatSize renders a byte measure at human scale. Sizes span lookup tables
  // of a few hundred bytes up to multi-TB warehouses, so every unit down to
  // bytes gets a branch: flooring a 4 KB table at "1 MB" would print a number
  // 256x larger than the one AWS reported. A stored 0 is a real reading and
  // prints as "0 B" — only an absent measure returns "" for the em dash.
  function formatSize(bytes) {
    if (typeof bytes !== "number" || bytes < 0) return "";
    var tb = bytes / 1099511627776;
    if (tb >= 1) return (tb >= 10 ? Math.round(tb) : tb.toFixed(1)) + " TB";
    var gb = bytes / 1073741824;
    if (gb >= 1) return (gb >= 10 ? Math.round(gb) : gb.toFixed(1)) + " GB";
    var mb = bytes / 1048576;
    if (mb >= 1) return (mb >= 10 ? Math.round(mb) : mb.toFixed(1)) + " MB";
    var kb = bytes / 1024;
    if (kb >= 1) return (kb >= 10 ? Math.round(kb) : kb.toFixed(1)) + " KB";
    return bytes + " B";
  }

  // formatObserved turns an observation timestamp into the short label printed
  // under a size that did not come from the scan.
  //
  // Most measures are read from a describe call and are current as of the
  // scan. A bucket's size is not: CloudWatch publishes BucketSizeBytes once a
  // day, so the newest datapoint can be two days old, and it would otherwise
  // sit in the same column as a table size read seconds ago with nothing to
  // separate them. Printing the day the value was observed is the whole
  // disclosure — a reader deciding whether a bucket grew last night needs to
  // know the report cannot answer that.
  //
  // Only a measure carrying an observation time gets a label, so the column
  // stays quiet for everything read directly.
  //
  // The date stays in UTC, which is what CloudWatch reported and what the
  // stored timestamp says. Rendering it in the reader's local time would move
  // the label across midnight for most of the world and have the report name a
  // different day than the one the datapoint belongs to — a day being exactly
  // the resolution in question here.
  function formatObserved(raw) {
    var m = /^(\d{4})-(\d{2})-(\d{2})T/.exec(String(raw || ""));
    if (!m) return "";
    var d = new Date(raw);
    if (isNaN(d.getTime())) return "";
    return "as of " + m[1] + "-" + m[2] + "-" + m[3];
  }

  function el(tag, cls, text) {
    var e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined && text !== null && text !== "") e.textContent = text;
    return e;
  }

  function plural(n, noun) {
    return n.toLocaleString() + " " + noun + (n === 1 ? "" : "s");
  }

  // ---- Header metadata ------------------------------------------------------
  var gen = new Date(meta.generated_at);
  var genEl = document.getElementById("gen-at");
  genEl.textContent = isNaN(gen.getTime())
    ? String(meta.generated_at || "")
    : gen.toLocaleString(undefined, { year: "numeric", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" });
  genEl.title = String(meta.generated_at || "");

  var verEl = document.getElementById("brand-ver");
  if (meta.version) { verEl.textContent = String(meta.version); } else { verEl.hidden = true; }

  var accounts = meta.accounts || [];
  var regions = meta.regions || [];
  document.getElementById("chip-scope").textContent =
    plural(accounts.length, "account") + " · " + plural(regions.length, "region") + " · " + plural(total, "resource");

  // ---- Failures banner (honesty ledger) ------------------------------------
  if (failures.length > 0) {
    document.getElementById("failures-banner").hidden = false;
    document.getElementById("failures-title").textContent =
      "Incomplete coverage — " + failures.length + " scan unit" + (failures.length === 1 ? "" : "s") + " failed";
    var list = document.getElementById("failures-list");
    failures.forEach(function (f) {
      var li = el("li");
      li.appendChild(el("span", "mono", [f.account_id, f.region, f.service].filter(Boolean).join(" / ")));
      li.appendChild(document.createTextNode(" — "));
      li.appendChild(el("span", "failure-error", f.error));
      list.appendChild(li);
    });
  }

  // ---- Empty state ----------------------------------------------------------
  // A census with no resources needs none of the rest of the page, and — the
  // reason this check sits above the decode rather than after it — no census
  // block either. Returning here means an empty report never touches
  // DecompressionStream, so it opens in any browser.
  if (total === 0) {
    document.getElementById("empty-state").hidden = false;
    ["stats-section", "engines-section", "table-section"].forEach(function (id) {
      document.getElementById(id).hidden = true;
    });
    return;
  }

  // Tier filter composes with the free-text filter via AND.
  var activeTier = null;

  // ---- Stat strip -----------------------------------------------------------
  var noOwner = summary.no_owner || 0;
  var eolCount = summary.eol || 0;
  var exposedCount = summary.exposed || 0;

  var kpisEl = document.getElementById("kpis");
  function addStat(label, num, sub, opts) {
    var box = el("div", "rr-kpi");
    box.appendChild(el("div", "rr-kpi-label", label));
    var numEl = el("div", "rr-kpi-num", num);
    if (opts && opts.denom) numEl.appendChild(el("span", "rr-kpi-denom", opts.denom));
    box.appendChild(numEl);
    var subCls = "rr-kpi-sub";
    if (opts && opts.ok) subCls += " rr-kpi-sub-ok";
    if (opts && opts.bad) subCls += " rr-kpi-sub-bad";
    box.appendChild(el("div", subCls, sub));
    kpisEl.appendChild(box);
  }
  addStat("Resources", total.toLocaleString(),
    plural(summary.types || 0, "type") + " · " + plural(summary.accounts || 0, "account"));
  addStat("Attribution score", String(Math.round((100 * TIER_BY_KEY.full.count) / total)),
    "owner + environment tagged", { denom: "/100" });
  addStat("Untagged", TIER_BY_KEY.untagged.count.toLocaleString(), "no owner or environment");
  addStat("Missing owner", noOwner.toLocaleString(), Math.round((100 * noOwner) / total) + "% of all resources");
  addStat("End-of-life", eolCount.toLocaleString(),
    eolCount === 0 ? "no EOL engine or runtime versions" : "support ended",
    eolCount === 0 ? { ok: true } : { bad: true });
  addStat("Exposed", exposedCount.toLocaleString(),
    exposedCount === 0 ? "no exposure flags" : "public, unencrypted, or no backups",
    exposedCount === 0 ? { ok: true } : { bad: true });
  addStat("Scan failures", failures.length.toLocaleString(),
    failures.length === 0 ? "every scan unit succeeded" : "see incomplete-coverage details above",
    { ok: failures.length === 0 });

  // ---- Attribution bar + legend ---------------------------------------------
  var barEl = document.getElementById("attr-bar");
  TIERS.forEach(function (t) {
    if (t.count === 0) return;
    var seg = el("div", "rr-attr-seg");
    seg.style.background = t.color;
    seg.style.flex = t.count + " 1 0%";
    seg.title = t.label + " · " + plural(t.count, "resource");
    seg.addEventListener("click", function () { setTier(t.key); });
    t._seg = seg;
    barEl.appendChild(seg);
  });

  var legendEl = document.getElementById("attr-legend");
  TIERS.forEach(function (t) {
    var btn = el("button", "rr-legend-item");
    btn.type = "button";
    btn.setAttribute("aria-pressed", "false");
    var dot = el("span", "rr-legend-dot");
    dot.style.background = t.color;
    btn.appendChild(dot);
    btn.appendChild(el("span", "", t.label));
    btn.appendChild(el("span", "rr-legend-count", t.count.toLocaleString()));
    btn.addEventListener("click", function () { setTier(t.key); });
    t._leg = btn;
    legendEl.appendChild(btn);
  });

  function setTier(key) {
    activeTier = activeTier === key ? null : key;
    syncTierUI();
    rebuild(false);
  }

  function syncTierUI() {
    TIERS.forEach(function (t) {
      var dimmed = activeTier !== null && activeTier !== t.key;
      if (t._seg) t._seg.style.opacity = dimmed ? "0.25" : "1";
      if (t._leg) {
        t._leg.style.opacity = dimmed ? "0.25" : "1";
        t._leg.setAttribute("aria-pressed", activeTier === t.key ? "true" : "false");
      }
    });
  }

  // ---- Engines ----------------------------------------------------------------
  // Already folded, ranked and deduplicated in Go. Services with no platform
  // concept (object stores, networking, storage) contribute no row rather than
  // piling into an "(unknown)" bucket that would imply blueprint failed to read
  // something.
  var engineRows = summary.platforms || [];

  var engRowsEl = document.getElementById("engine-rows");
  var max = 1;
  engineRows.forEach(function (e) { if (e.count > max) max = e.count; });
  var engFrag = document.createDocumentFragment();
  engineRows.forEach(function (e) {
    var row = el("div", "rr-eng-row");
    var entity = el("div", "rr-eng-entity");
    var dot = el("span", "rr-eng-dot");
    dot.style.background = hashColor(e.service);
    entity.appendChild(dot);
    entity.appendChild(el("span", "rr-eng-name", e.name));
    row.appendChild(entity);
    row.appendChild(el("div", "rr-eng-family",
      e.versions > 0 ? e.service + " · " + plural(e.versions, "version") : e.service));
    var barWrap = el("div", "rr-bar-wrap");
    var bar = el("div", "rr-bar");
    bar.style.width = Math.round((e.count / max) * 100) + "%";
    barWrap.appendChild(bar);
    row.appendChild(barWrap);
    row.appendChild(el("div", "rr-eng-total", e.count.toLocaleString()));
    row.appendChild(el("div", "rr-eng-regions", plural(e.regions || 0, "region")));
    engFrag.appendChild(row);
  });
  engRowsEl.replaceChildren(engFrag);
  document.getElementById("engines-sub").textContent =
    plural(engineRows.length, "platform") + " · " + plural(summary.services || 0, "service");
  // Nothing in scope reports a platform — hide the section instead of showing
  // an empty chart.
  if (engineRows.length === 0) document.getElementById("engines-section").hidden = true;

  // ---- Inventory table ----------------------------------------------------
  var COLUMNS = [
    { key: "name", label: "Name" },
    { key: "service", label: "Service" },
    { key: "_engine", label: "Platform" },
    { key: "_class", label: "Class" },
    { key: "_sizeBytes", label: "Size", num: true },
    { key: "region", label: "Region" },
    { key: "account_id", label: "Account" },
    { key: "environment", label: "Environment" },
    { key: "owner", label: "Owner" },
    { key: "status", label: "Status" }
  ];
  var GROUP_FIELD = { service: "service", type: "type", engine: "_engine", environment: "environment", region: "region", account: "account_id" };

  var filterEl = document.getElementById("filter");
  var groupEl = document.getElementById("groupby");
  var countEl = document.getElementById("row-count");
  var tbody = document.getElementById("rows");
  var sortKey = null;
  var sortDir = 1;

  var headRow = document.getElementById("head-row");
  COLUMNS.forEach(function (c) {
    var th = document.createElement("th");
    th.scope = "col";
    if (c.num) th.className = "num";
    var btn = el("button", "th-btn");
    btn.type = "button";
    btn.appendChild(el("span", "", c.label));
    var dir = el("span", "dir");
    btn.appendChild(dir);
    btn.addEventListener("click", function () {
      if (sortKey === c.key) {
        if (sortDir === 1) { sortDir = -1; } else { sortKey = null; sortDir = 1; }
      } else {
        sortKey = c.key;
        sortDir = 1;
      }
      updateSortIndicators();
      rebuild(false);
    });
    th.appendChild(btn);
    headRow.appendChild(th);
    c._th = th;
    c._dir = dir;
  });

  function updateSortIndicators() {
    COLUMNS.forEach(function (c) {
      var active = c.key === sortKey;
      c._dir.textContent = active ? (sortDir === 1 ? "▲" : "▼") : "";
      c._th.setAttribute("aria-sort", active ? (sortDir === 1 ? "ascending" : "descending") : "none");
    });
  }

  // Size is the only numeric column, and a resource whose service never
  // reported a size is not a zero-byte resource. Folding absence to zero
  // interleaved the two, so sorting by Size buried genuinely empty tables among
  // rows that simply had nothing to say about their size. null keeps them
  // apart; compareRows puts them in their own block.
  function sortValue(r, key) {
    if (key === "_sizeBytes") return typeof r._sizeBytes === "number" ? r._sizeBytes : null;
    return String(r[key] || "").toLowerCase();
  }

  // compareRows orders by the column value; equal engine names are tie-broken
  // by engine version compared numerically, so "15.4" sorts after "9.6".
  function compareRows(a, b, key) {
    var av = sortValue(a, key);
    var bv = sortValue(b, key);
    if (av === null || bv === null) {
      if (av === bv) return 0;
      // The caller multiplies by sortDir, so multiplying by it here cancels:
      // unreported sizes stay together at the bottom whichever way the arrow
      // points, rather than swapping to the top and reading as the smallest
      // values in the census.
      return (av === null ? 1 : -1) * sortDir;
    }
    if (typeof av === "number") return av - bv;
    if (av !== bv) return av < bv ? -1 : 1;
    if (key === "_engine") {
      return String(a._engineVersion || "").localeCompare(String(b._engineVersion || ""), undefined, { numeric: true });
    }
    return 0;
  }

  function cellOrDash(v, cls) {
    var c = el("td", cls);
    if (v) {
      c.textContent = v;
    } else {
      c.textContent = "—";
      c.className = (cls ? cls + " " : "") + "dim";
    }
    return c;
  }

  // Environment tags are colored by normalized bucket so "prod", "prd" and
  // "production" read as the same thing; unrecognized values stay neutral.
  var ENV_BUCKETS = [
    { cls: "tag-purple", re: /^(prod|prd|production|live)$/ },
    { cls: "tag-cyan", re: /^(stag(e|ing)?|stg|pre-?prod|uat)$/ },
    { cls: "tag-blue", re: /^(dev|development)$/ },
    { cls: "tag-pink", re: /^(test(ing)?|qa|sandbox|sbx)$/ }
  ];
  function envClass(v) {
    v = v.toLowerCase();
    for (var i = 0; i < ENV_BUCKETS.length; i++) {
      if (ENV_BUCKETS[i].re.test(v)) return ENV_BUCKETS[i].cls;
    }
    return "";
  }

  // Status tags map AWS lifecycle states to a traffic light: healthy green,
  // gone-wrong red, intentionally-off amber, in-transition blue.
  function statusClass(v) {
    v = v.toLowerCase();
    if (/^(available|active|running|healthy)$/.test(v)) return "tag-green";
    if (/fail|error|incompatible|inaccessible|storage-full|delet/.test(v)) return "tag-red";
    if (/stopp|paus|inactive/.test(v)) return "tag-amber";
    if (/creat|modif|backing|start|reboot|upgrad|updat|maint|resiz|renam|migrat|snapshot|configur/.test(v)) return "tag-blue";
    return "";
  }

  function tagCell(v, cls, withDot) {
    if (!v) return cellOrDash("", "");
    var td = document.createElement("td");
    var tag = el("span", "tag" + (cls ? " " + cls : ""));
    if (withDot) tag.appendChild(el("span", "tag-dot"));
    tag.appendChild(el("span", "", v));
    td.appendChild(tag);
    return td;
  }

  function buildRow(r) {
    var tr = document.createElement("tr");

    var name = el("td", "mono");
    var tierDot = el("span", "tier-dot");
    tierDot.style.background = TIER_BY_KEY[r._tier].color;
    tierDot.title = TIER_BY_KEY[r._tier].label;
    name.appendChild(tierDot);
    name.appendChild(document.createTextNode(r.name || ""));
    if (r.arn) name.title = r.arn;
    tr.appendChild(name);

    var svc = el("td", "", "");
    svc.appendChild(el("span", "", r.service || ""));
    if (r._typeShort) {
      svc.appendChild(document.createTextNode(" "));
      var typeEl = el("span", "sub", r._typeShort);
      typeEl.title = r.type;
      svc.appendChild(typeEl);
    }
    tr.appendChild(svc);

    var eng = el("td", "", "");
    eng.appendChild(el("span", "", r._engine));
    if (r._engineVersion) {
      eng.appendChild(document.createTextNode(" "));
      eng.appendChild(el("span", "sub", r._engineVersion));
    }
    if (r.eol) {
      eng.appendChild(document.createTextNode(" "));
      var eol = el("span", "tag tag-red", "EOL");
      if (r.eol_date) eol.title = "end of life: " + r.eol_date;
      eng.appendChild(eol);
    }
    tr.appendChild(eng);

    tr.appendChild(cellOrDash(r._class, "mono"));

    var sizeTd = cellOrDash(formatSize(r._sizeBytes), "num");
    var observed = formatObserved(r._sizeAsOf);
    if (observed && typeof r._sizeBytes === "number") {
      sizeTd.appendChild(el("span", "sub", observed));
      sizeTd.title = "observed " + r._sizeAsOf +
        " — CloudWatch publishes this daily, so it can be up to 48h behind, and it counts noncurrent versions and incomplete multipart uploads";
    }
    tr.appendChild(sizeTd);

    tr.appendChild(cellOrDash(r.region, "mono"));
    tr.appendChild(cellOrDash(r.account_id, "mono"));
    tr.appendChild(tagCell(r.environment, envClass(r.environment || ""), false));
    tr.appendChild(cellOrDash(r.owner, ""));
    var statusTd = tagCell(r.status, statusClass(r.status || ""), true);
    if (r.publicly_accessible === true) {
      statusTd.appendChild(document.createTextNode(" "));
      statusTd.appendChild(el("span", "tag tag-red", "public"));
    }
    if (r.encrypted === false) {
      statusTd.appendChild(document.createTextNode(" "));
      statusTd.appendChild(el("span", "tag tag-amber", "unencrypted"));
    }
    if (r._backup === 0) {
      statusTd.appendChild(document.createTextNode(" "));
      statusTd.appendChild(el("span", "tag tag-amber", "no backups"));
    }
    tr.appendChild(statusTd);
    return tr;
  }

  function filterActive() {
    return activeTier !== null || filterEl.value.trim() !== "";
  }

  function currentRows() {
    var q = filterEl.value.trim().toLowerCase();
    var terms = q ? q.split(/\s+/) : null;
    var rows = [];
    for (var i = 0; i < resources.length; i++) {
      var r = resources[i];
      if (activeTier && r._tier !== activeTier) continue;
      if (terms) {
        var hay = hayOf(r);
        var matched = true;
        for (var j = 0; j < terms.length; j++) {
          if (hay.indexOf(terms[j]) === -1) { matched = false; break; }
        }
        if (!matched) continue;
      }
      rows.push(r);
    }
    if (sortKey) {
      rows.sort(function (a, b) {
        return sortDir * compareRows(a, b, sortKey);
      });
    }
    return rows;
  }

  // ---- Grouping -------------------------------------------------------------
  //
  // Past a few hundred resources the table opens grouped and closed. A census
  // is not a list anybody reads top to bottom; the first useful thing it can
  // say is where the estate actually is — "ec2 · 1,284 resources · 41,208.00
  // USD" — and fifty thousand rows say that in about twenty-five lines. The
  // reader opens the part they came for.
  var GROUP_COLLAPSE_ABOVE = 500;

  // Explicit open/closed state, per dimension, for the groups the reader has
  // actually clicked. Everything else follows defaultOpen().
  var openByDim = Object.create(null);
  var preFilterOpen = null;
  var allOpen = false;
  var filterWasActive = false;

  function defaultOpen() { return allOpen || total <= GROUP_COLLAPSE_ABOVE; }

  function isOpen(dim, value) {
    var m = openByDim[dim];
    if (m && Object.prototype.hasOwnProperty.call(m, value)) return m[value];
    return defaultOpen();
  }

  function setOpen(dim, value, open) {
    if (!openByDim[dim]) openByDim[dim] = Object.create(null);
    openByDim[dim][value] = open;
  }

  // A filter opens every group for as long as it is on. Three matches hiding
  // inside three closed groups looks exactly like no matches at all, which
  // would make the search box lie. The reader's own collapsing is put aside
  // rather than thrown away, and comes back when the filter clears — so the
  // carets always describe what is really on screen, and clicking one while
  // filtering still works.
  function syncFilterCollapse() {
    var now = filterActive();
    if (now === filterWasActive) return;
    filterWasActive = now;
    if (now) {
      preFilterOpen = openByDim;
      openByDim = Object.create(null);
      allOpen = true;
    } else {
      openByDim = preFilterOpen || Object.create(null);
      preFilterOpen = null;
      allOpen = false;
    }
  }

  // costIndex maps a group value to the spend Go attributed to it. The totals
  // describe the whole census, so they are only ever shown — and only ever
  // sorted on — when no filter is narrowing the view; printing a census-wide
  // total beside a filtered count would invite the reader to divide one by the
  // other.
  var costIndexCache = Object.create(null);
  function costIndex(dim) {
    if (costIndexCache[dim]) return costIndexCache[dim];
    var out = Object.create(null);
    ((summary.groups || {})[dim] || []).forEach(function (g) {
      out[g.value] = g;
    });
    costIndexCache[dim] = out;
    return out;
  }

  // Group totals are decimal strings and they are compared as decimals, digit
  // by digit. Money that reached this page exactly is not going to be pushed
  // through a float for the sake of a sort. This runs only when the summary
  // says one method and one currency priced every resource in the census, so a
  // group has at most one total to compare and no group is ranked on a total
  // that covers only part of it.
  function compareGroupCost(a, b) {
    var ac = a && a.costs, bc = b && b.costs;
    var av = ac && ac.length ? ac[0].amount : null;
    var bv = bc && bc.length ? bc[0].amount : null;
    if (av === null && bv === null) return 0;
    if (av === null) return -1;
    if (bv === null) return 1;
    return compareDecimal(av, bv);
  }

  function compareDecimal(a, b) {
    var an = a.charAt(0) === "-";
    var bn = b.charAt(0) === "-";
    if (an !== bn) return an ? -1 : 1;
    var m = compareMagnitude(an ? a.slice(1) : a, bn ? b.slice(1) : b);
    return an ? -m : m;
  }

  // Longer whole part wins; same length compares lexicographically, which for
  // equal-length digit strings is the same as comparing the numbers. Fractions
  // are zero-padded to a common length so "1.5" and "1.45" compare correctly.
  function compareMagnitude(a, b) {
    var ap = a.split(".");
    var bp = b.split(".");
    var aw = ap[0].replace(/^0+(?=\d)/, "");
    var bw = bp[0].replace(/^0+(?=\d)/, "");
    if (aw.length !== bw.length) return aw.length < bw.length ? -1 : 1;
    if (aw !== bw) return aw < bw ? -1 : 1;
    var af = ap[1] || "";
    var bf = bp[1] || "";
    var width = Math.max(af.length, bf.length);
    while (af.length < width) af += "0";
    while (bf.length < width) bf += "0";
    if (af !== bf) return af < bf ? -1 : 1;
    return 0;
  }

  // flatten turns the filtered rows into the single sequence the body paints:
  // group headers interleaved with the rows of the groups that are open. It is
  // one array so that virtualization has one thing to index into.
  function flatten(rows, groupBy) {
    if (groupBy === "none" || !GROUP_FIELD[groupBy]) return rows;
    var field = GROUP_FIELD[groupBy];
    var groups = Object.create(null);
    var order = [];
    for (var i = 0; i < rows.length; i++) {
      var v = String(rows[i][field] || "");
      if (!Object.prototype.hasOwnProperty.call(groups, v)) {
        groups[v] = [];
        order.push(v);
      }
      groups[v].push(rows[i]);
    }

    var showCost = !filterActive();
    var costs = costIndex(groupBy);
    var byCost = showCost && summary.cost_sortable === true;
    order.sort(function (a, b) {
      if (a === "") return 1;
      if (b === "") return -1;
      if (byCost) {
        var c = compareGroupCost(costs[b], costs[a]);
        if (c !== 0) return c;
      }
      return groups[b].length - groups[a].length || (a < b ? -1 : a > b ? 1 : 0);
    });

    var out = [];
    for (var k = 0; k < order.length; k++) {
      var value = order[k];
      var open = isOpen(groupBy, value);
      out.push({
        _group: value,
        _dim: groupBy,
        _rows: groups[value].length,
        _spend: showCost ? costs[value] : null,
        _open: open
      });
      if (open) {
        var members = groups[value];
        for (var m = 0; m < members.length; m++) out.push(members[m]);
      }
    }
    return out;
  }

  var COST_METHODS = {
    ce: "Cost Explorer — what AWS billed over a closed window",
    coh: "Cost Optimization Hub — modelled monthly rate for the current configuration"
  };

  // A group prints one total per (method, currency) pair its resources were
  // priced in, side by side rather than combined: a billed figure and a
  // modelled forecast answer different questions, and adding across currencies
  // needs a rate this tool does not have. A total containing a caveated figure
  // prices a component rather than a whole resource, so it is a lower bound and
  // is marked as one instead of passing for the full bill.
  function appendGroupCost(btn, spend) {
    var costs = spend && spend.costs;
    if (!costs || costs.length === 0) return;
    var wrap = el("span", "group-cost");
    costs.forEach(function (c, i) {
      if (i > 0) wrap.appendChild(el("span", "sub", "·"));
      var span = el("span", "", (c.qualified ? "≥ " : "") + c.amount + " " + c.currency);
      span.title = COST_METHODS[c.method] || c.method;
      if (c.qualified) {
        span.title += " — lower bound: at least one figure in this total prices a component, not the whole resource";
      }
      wrap.appendChild(span);
    });
    // The count beside the group name is every member; the total is only over
    // the ones something priced. Where those differ the header says so, because
    // the two read as a pair and the pair would otherwise state that the whole
    // group costs what its priced fraction costs.
    if (spend.priced < spend.total) {
      var note = el("span", "group-partial",
        "over " + spend.priced + " of " + spend.total);
      note.title = "cost unavailable for " + (spend.total - spend.priced) +
        " of " + spend.total + " resources in this group — the total is a lower " +
        "bound, and groups are ordered by resource count rather than spend " +
        "while any group is short";
      wrap.appendChild(note);
    }
    btn.appendChild(wrap);
  }

  function buildGroupRow(g) {
    var tr = el("tr", "group-row");
    var td = document.createElement("td");
    td.colSpan = COLUMNS.length;
    var btn = el("button", "group-btn");
    btn.type = "button";
    btn.setAttribute("aria-expanded", g._open ? "true" : "false");
    btn.appendChild(el("span", "group-caret", g._open ? "▼" : "▶"));
    btn.appendChild(el("span", "group-name",
      g._group || (g._dim === "environment" ? "no environment tag" : "(none)")));
    btn.appendChild(el("span", "group-count", plural(g._rows, "resource")));
    appendGroupCost(btn, g._spend);
    btn.addEventListener("click", function () {
      setOpen(g._dim, g._group, !isOpen(g._dim, g._group));
      rebuild(true);
    });
    td.appendChild(btn);
    tr.appendChild(td);
    return tr;
  }

  // ---- Virtualized body -----------------------------------------------------
  //
  // The body holds the rows that are on screen and nothing else.
  //
  // One row is about twenty-five DOM nodes. Fifty thousand of them is over a
  // million nodes — long enough to lay out that the browser offers to kill the
  // tab — and the old renderer rebuilt every one of them on every keystroke.
  // Here the body holds about sixty rows whatever the census size, with a
  // spacer above and below standing in for the rest so the scrollbar keeps its
  // true length and a scroll position keeps its true meaning.
  //
  // Group headers are taller than data rows, so the visible window cannot be
  // found by dividing. Each rebuild fills a prefix-sum table of row offsets in
  // one pass and each paint binary-searches it. Row heights come from CSS, so
  // they are measured off the first painted window rather than hard-coded.
  var OVERSCAN = 8;
  var ROW_H = 31;
  var GROUP_H = 34;
  // Measured per kind, not once overall. A census that opens grouped and
  // collapsed paints nothing but group headers, so a single flag would take the
  // first window as proof of both and leave the data-row height at its guess
  // for the session — in exactly the view this virtualization exists to serve.
  var measuredRow = false;
  var measuredGroup = false;

  var wrap = document.getElementById("table-wrap");
  var view = [];
  var offsets = null;
  var firstPainted = -1;
  var lastPainted = -1;

  function isGroup(item) { return item._group !== undefined; }
  function heightOf(item) { return isGroup(item) ? GROUP_H : ROW_H; }

  function spacer() {
    var tr = el("tr", "spacer");
    var td = document.createElement("td");
    td.colSpan = COLUMNS.length;
    // The height lives on an inner div: a td's own height is a minimum that
    // the table layout is free to ignore, a block box's is not.
    var box = document.createElement("div");
    td.appendChild(box);
    tr.appendChild(td);
    tr._box = box;
    return tr;
  }
  var topSpacer = spacer();
  var bottomSpacer = spacer();

  function setSpacer(tr, px) {
    tr._box.style.height = px + "px";
    tr.hidden = px <= 0;
  }

  function buildOffsets() {
    var n = view.length;
    offsets = new Float64Array(n + 1);
    var y = 0;
    for (var i = 0; i < n; i++) {
      offsets[i] = y;
      y += heightOf(view[i]);
    }
    offsets[n] = y;
  }

  // indexAt returns the last entry starting at or before y.
  function indexAt(y) {
    var lo = 0;
    var hi = view.length - 1;
    if (hi < 0) return 0;
    while (lo < hi) {
      var mid = (lo + hi + 1) >> 1;
      if (offsets[mid] <= y) lo = mid; else hi = mid - 1;
    }
    return lo;
  }

  function noMatchRow() {
    var tr = el("tr", "no-match");
    var td = el("td", "dim", "No resources match the current filters.");
    td.colSpan = COLUMNS.length;
    tr.appendChild(td);
    return tr;
  }

  // The wrapper caps its height in CSS but never sets one, so clientHeight is
  // whatever it currently holds. Sizing the window from it measures the body
  // about to be replaced — on first paint, an empty one — and paints far too
  // few rows to cover the screen, leaving a blank strip until the next scroll
  // nudges it. The cap is the height the window actually has to fill, so it is
  // read from CSS once and refreshed when the viewport changes.
  var heightCap = 0;
  function measureCap() {
    var cap = parseFloat(getComputedStyle(wrap).maxHeight);
    heightCap = cap > 0 ? cap : 0;
  }
  function viewportHeight() { return Math.max(wrap.clientHeight, heightCap); }

  function paint(force) {
    if (!offsets) return;
    var n = view.length;
    if (n === 0) {
      firstPainted = lastPainted = -1;
      tbody.replaceChildren(noMatchRow());
      return;
    }
    var top = wrap.scrollTop;
    var first = Math.max(0, indexAt(top) - OVERSCAN);
    var last = Math.min(n - 1, indexAt(top + viewportHeight()) + OVERSCAN);
    if (!force && first === firstPainted && last === lastPainted) return;
    firstPainted = first;
    lastPainted = last;

    var sawRow = false;
    var sawGroup = false;
    var frag = document.createDocumentFragment();
    setSpacer(topSpacer, offsets[first]);
    frag.appendChild(topSpacer);
    for (var i = first; i <= last; i++) {
      var item = view[i];
      if (isGroup(item)) sawGroup = true; else sawRow = true;
      frag.appendChild(isGroup(item) ? buildGroupRow(item) : buildRow(item));
    }
    setSpacer(bottomSpacer, offsets[n] - offsets[last + 1]);
    frag.appendChild(bottomSpacer);
    tbody.replaceChildren(frag);

    // Only measure when this window holds a kind that has never been measured.
    // Asking otherwise would force a layout on every scroll frame for a number
    // already known.
    if ((sawRow && !measuredRow) || (sawGroup && !measuredGroup)) measureRowHeights();
  }

  // Row heights are a guess until a row exists to measure: CSS decides them,
  // and so do the reader's font settings and zoom level. Each kind is asked
  // once, off the first painted window that contains one, and the offset table
  // is rebuilt if the guess was wrong. The flags are set before the repaint, so
  // it cannot come back here and loop.
  function measureRowHeights() {
    var changed = false;
    var rows = tbody.children;
    for (var i = 0; i < rows.length; i++) {
      var tr = rows[i];
      var h = tr.offsetHeight;
      if (!h || tr.classList.contains("spacer")) continue;
      if (tr.classList.contains("group-row")) {
        measuredGroup = true;
        if (h !== GROUP_H) { GROUP_H = h; changed = true; }
      } else {
        measuredRow = true;
        if (h !== ROW_H) { ROW_H = h; changed = true; }
      }
    }
    if (!changed) return;
    buildOffsets();
    paint(true);
  }

  function rebuild(keepScroll) {
    if (!resources) return;
    syncFilterCollapse();
    var rows = currentRows();
    view = flatten(rows, groupEl.value);
    buildOffsets();
    if (!keepScroll) wrap.scrollTop = 0;
    paint(true);
    countEl.textContent = rows.length.toLocaleString() + " of " + total.toLocaleString() + " resources";
  }

  var scrollQueued = false;
  wrap.addEventListener("scroll", function () {
    if (scrollQueued) return;
    scrollQueued = true;
    requestAnimationFrame(function () {
      scrollQueued = false;
      paint(false);
    });
  });
  // A taller viewport shows more rows, so both the cap and the window have to
  // be recomputed even though nothing scrolled.
  window.addEventListener("resize", function () { measureCap(); paint(true); });

  var debounceTimer = null;
  filterEl.addEventListener("input", function () {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(function () { rebuild(false); }, 150);
  });
  groupEl.addEventListener("change", function () { rebuild(false); });

  // ---- Boot -----------------------------------------------------------------
  syncTierUI();
  updateSortIndicators();
  measureCap();
  if (total > GROUP_COLLAPSE_ABOVE) groupEl.value = "service";

  // The controls stay inert until there is something to control. Everything
  // above the table is already painted at this point; only the inventory is
  // waiting on the decode.
  filterEl.disabled = true;
  groupEl.disabled = true;
  countEl.textContent = "reading " + total.toLocaleString() + " resources…";

  decodeCensus().then(function (table) {
    resources = readTable(table);
    // The summary and the census block are folded from the same snapshot by
    // the same run. If they disagree about how many resources there are, one
    // of them is wrong and there is no way to tell which — so the page says so
    // rather than showing a table it cannot vouch for.
    if (resources.length !== total) {
      throw new Error("This report is inconsistent: it summarizes " +
        total.toLocaleString() + " resources but its inventory holds " +
        resources.length.toLocaleString() + ".");
    }
    precompute();
    filterEl.disabled = false;
    groupEl.disabled = false;
    rebuild(false);
  }).catch(failCensus);
})();
</script>
</body>
</html>
