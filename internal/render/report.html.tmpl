  // filler one, and every IAM action named here is one docs/iam-policy.json
  // already grants.
  function probeFix(outcome) {
    switch (outcome) {
      case "denied":
        return "Grant ce:GetCostAndUsageWithResources, or cost-optimization-hub:ListEnrollmentStatuses and " +
          "cost-optimization-hub:ListRecommendations, and check the account is opted in to that service.";
      case "empty":
      case "unsupported":
        return "Resource-level Cost Explorer data has to be switched on in Billing preferences and reaches back " +
          "about 14 days. For services Cost Explorer will not break down, enroll the account in Cost Optimization " +
          "Hub and rerun with --costs --cost-resources.";
      case "skipped":
        return "Raise the request budget or narrow the scan so the remaining services get asked.";
      case "uncensused":
        return "Nothing to fix: no scanner in this run covers that service, so there is no resource here to " +
          "attach its spend to.";
