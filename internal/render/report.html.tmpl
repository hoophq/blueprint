  // formatMoney mirrors render.FormatMoney: the amount verbatim, the currency
  // appended when the source named one. No symbol is invented for a code this
  // tool was never told the meaning of.
  function formatMoney(amount, currency) {
    if (!currency) return amount;
    return amount + " " + currency;
  }

  // ---- Cost model -----------------------------------------------------------

  var costReport = meta.cost || null;
  var resourceCostReport = meta.resource_cost || null;
  var probes = (resourceCostReport && resourceCostReport.probes) || [];

  // COST holds the single axis the whole overlay reads. Nothing here is ever
  // summed or ranked across a method or a currency: "ce" is what AWS billed,
  // "coh" is what Cost Optimization Hub modelled, and adding the two would
  // publish a number neither service reported.
  var COST = {
    attempted: false,
    // counted separates "the census has not been read" from "the census was
    // read and nothing in it was priced". Every other field renders the two
    // identically — priced 0, active false — and they are not the same claim.
    // The census decodes asynchronously, so when the cost panels first paint
    // nothing is known about the rows either way, and if the decode fails
    // nothing ever will be. Saying "no resource-level figure reached any
    // resource" in either state would be a finding about data nobody read.
    counted: false,
    active: false,
    method: "",
    currency: "",
    methods: [],
    // currencyBy is each source's own dominant currency, keyed by method. The
    // table shows every source at once, so "the currency" is no longer a single
    // fact about the page — COST.currency is only the one the totals are summed
    // in, and judging a Cost Optimization Hub figure against it would call a
    // column foreign to itself.
    currencyBy: {},
    priced: 0,
    caveated: 0
